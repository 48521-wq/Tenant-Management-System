    list.innerHTML = items.map(c => `
      <div class="list-item">
        <div style="flex:1">
          <div class="li-title">${c.subject}</div>
          <div class="li-sub">${c.category||''} · ${new Date(c.createdAt).toLocaleDateString('en-PK',{day:'numeric',month:'short',year:'numeric'})}</div>
          ${c.adminNote?`<div style="font-size:11px;color:var(--blue);margin-top:3px">Admin: ${c.adminNote}</div>`:''}
        </div>
        <span class="badge ${statusMap[c.status]||'b-warn'}">${c.status?.replace('_',' ')||'open'}</span>
      </div>
    `).join('');
  } catch { list.innerHTML = '<div class="loading">⚠️ Error loading.</div>'; }
}
async function submitComp() {
