// ═══════════════════════════════════════════════════════
//  RENTAL REQUESTS
// ═══════════════════════════════════════════════════════
function showRequestModal(propertyId) {
  const prop = window._tenantPropMap[propertyId];
  if (!prop) { alert('Property not found'); return; }
  
  const modal = document.createElement('div');
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:9999;backdrop-filter:blur(2px)';
  modal.innerHTML = `
    <div style="background:var(--card);border:1px solid var(--border);border-radius:16px;padding:28px;max-width:400px;width:90%;max-height:80vh;overflow-y:auto">
      <div style="font-size:18px;font-weight:700;margin-bottom:8px;color:var(--text)">${prop.title}</div>
      <div style="font-size:12px;color:var(--muted);margin-bottom:24px">Request to rent this property</div>
      
      <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:20px">
        <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border)">
          <span style="color:var(--muted);font-size:12px">Monthly Rent:</span>
          <span style="font-weight:600;color:var(--blue)">Rs. ${Number(prop.rent||0).toLocaleString()}</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border)">
          <span style="color:var(--muted);font-size:12px">Location:</span>
          <span style="font-weight:600;color:var(--text)">${prop.address}</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:8px 0">
          <span style="color:var(--muted);font-size:12px">Type:</span>
          <span style="font-weight:600;color:var(--text)">${prop.type} (${prop.beds} bed, ${prop.baths} bath)</span>
        </div>
      </div>

      <div style="display:flex;flex-direction:column;gap:5px;margin-bottom:16px">
        <label style="font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:0.4px">Message (Optional)</label>
        <textarea id="request-message" placeholder="Tell the landlord why you're interested..." style="background:var(--input-bg);border:1.5px solid var(--border);border-radius:9px;padding:10px 13px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;outline:none;resize:vertical;min-height:80px;width:100%;transition:border-color 0.2s" onFocus="this.style.borderColor='var(--blue)'" onBlur="this.style.borderColor='var(--border)'"></textarea>
      </div>

      <div style="display:flex;gap:10px">
        <button onclick="this.parentElement.parentElement.parentElement.remove()" style="flex:1;padding:10px;border-radius:9px;border:1.5px solid var(--border);background:var(--input-bg);color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;cursor:pointer">Cancel</button>
        <button onclick="submitRentalRequest('${propertyId}', this.parentElement.parentElement)" style="flex:1;padding:10px;border-radius:9px;border:none;background:linear-gradient(135deg,#4ECDC4,#45B7A8);color:#fff;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;cursor:pointer">Send Request</button>
      </div>
    </div>
  `;
  document.body.appendChild(modal);
}

async function submitRentalRequest(propertyId, modalEl) {
  const message = document.getElementById('request-message')?.value?.trim() || '';
  const btn = event.target;
  btn.disabled = true;
  btn.textContent = 'Sending…';
  
  try {
    const r = await tFetch('/rental-requests/request', 'POST', { propertyId, message });
    if (r.success) {
      alert('✅ Request sent to landlord!');
      // Close all request modals
      document.querySelectorAll('[style*="position:fixed"]').forEach(el => {
        if (el.textContent.includes('Send Request')) el.remove();
      });
      await loadRentalRequests();
    } else {
      alert('⚠️ ' + (r.message || 'Failed to send request'));
      btn.disabled = false;
      btn.textContent = 'Send Request';
    }
  } catch(e) {
    alert('❌ Cannot connect to server');
    btn.disabled = false;
    btn.textContent = 'Send Request';
  }
}

async function loadRentalRequests() {
  const list = document.getElementById('rental-requests-list');
  if (!list) return;
  list.innerHTML = '<div class="loading"><span class="spinner"></span>Loading your requests…</div>';
  try {
    const data = await tFetch('/rental-requests/my-requests');
    const requests = data.requests || [];
    
    // Update badge
    const badge = document.getElementById('rental-requests-badge');
    const pendingCount = requests.filter(r => r.status === 'pending').length;
    if (badge) {
      badge.textContent = pendingCount;
      badge.style.display = pendingCount > 0 ? 'flex' : 'none';
    }
    
    if (!requests.length) {
      list.innerHTML = '<div class="loading" style="padding:20px">No rental requests yet. Browse properties and send requests!</div>';
      return;
    }
    
    const statusBadges = {
      pending: 'b-warn',
      accepted: 'b-green',
      rejected: 'b-red',
      cancelled: 'b-muted'
    };
    
    const statusEmoji = {
      pending: '⏳',
      accepted: '✅',
      rejected: '❌',
      cancelled: '🚫'
    };
    
    list.innerHTML = requests.map(req => `
      <div class="list-item" style="margin-bottom:10px;flex-direction:column;align-items:flex-start">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;width:100%;gap:10px">
          <div style="flex:1">
            <div class="li-title">${req.propertyTitle} - ${req.propertyAddress}</div>
            <div class="li-sub">📍 Rent: Rs. ${Number(req.propertyRent||0).toLocaleString()}/month · Landlord: ${req.landlordName}</div>
            <div style="font-size:11px;color:var(--muted);margin-top:4px">Requested: ${new Date(req.requestedAt).toLocaleDateString('en-PK',{day:'numeric',month:'short',year:'numeric'})}</div>
            ${req.message?`<div style="font-size:12px;color:var(--text);margin-top:6px;padding:8px;background:var(--input-bg);border-left:2px solid var(--blue);border-radius:4px">"${req.message}"</div>`:''}
            ${req.respondedAt?`<div style="font-size:11px;color:var(--muted);margin-top:4px">Responded: ${new Date(req.respondedAt).toLocaleDateString('en-PK',{day:'numeric',month:'short',year:'numeric'})}</div>`:''}
          </div>
          <span class="badge ${statusBadges[req.status]||'b-warn'}">${statusEmoji[req.status]||''} ${req.status}</span>
        </div>
        ${req.status === 'pending' ? `<div style="display:flex;gap:8px;margin-top:10px;width:100%">
          <button onclick="cancelRentalRequest('${req._id}')" style="flex:1;padding:6px 12px;border-radius:7px;border:1px solid var(--border);background:var(--input-bg);color:var(--text);font-size:11px;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif">Cancel Request</button>
        </div>` : ''}
      </div>
    `).join('');
  } catch(e) {
    list.innerHTML = '<div class="loading">⚠️ Error loading requests.</div>';
  }
}

async function cancelRentalRequest(requestId) {
  if (!confirm('Are you sure you want to cancel this request?')) return;
  try {
    const r = await tFetch('/rental-requests/'+requestId+'/cancel', 'PUT', {});
    if (r.success) {
      alert('✅ Request cancelled');
      await loadRentalRequests();
    } else alert('❌ ' + (r.message || 'Failed'));
  } catch { alert('❌ Cannot connect to server'); }
}

// ═══════════════════════════════════════════════════════
//  PAYMENTS
// ═══════════════════════════════════════════════════════
async function loadPayments() {
  populatePropertyDropdowns();
  const tbody = document.getElementById('pay-tbody');
  const stats = document.getElementById('pay-stats');
  if (!tbody) return;
  tbody.innerHTML = '<tr><td colspan="7" class="loading"><span class="spinner"></span>Loading…</td></tr>';
  try {
    const data = await tFetch('/payments');
    let items = data.payments || [];

    const currentPropertyIds = Object.keys(window._tenantPropMap || {}).map(id => id.toString());
    if (currentPropertyIds.length) {
      items = items.filter(p => p.propertyId && currentPropertyIds.includes(p.propertyId.toString()));
    } else {
      // If tenant has no assigned properties, hide any orphan payments
      items = items.filter(p => false);
    }

    if (stats) {
      const total = items.reduce((a,p)=>a+(p.amount||0),0);
      const paid  = items.filter(p=>p.status==='paid').length;
      stats.innerHTML = `
        <div class="stat-card"><div class="stat-num">${items.length}</div><div class="stat-lbl">Total Records</div></div>
        <div class="stat-card"><div class="stat-num" style="color:var(--green)">${paid}</div><div class="stat-lbl">Paid</div></div>
        <div class="stat-card"><div class="stat-num" style="color:var(--gold)">Rs. ${total.toLocaleString()}</div><div class="stat-lbl">Total Paid</div></div>
      `;
    }
    if (!items.length) { tbody.innerHTML = '<tr><td colspan="7" class="loading">No payment records yet.</td></tr>'; return; }
    tbody.innerHTML = items.map(p => `<tr>
      <td>${p.month||'—'}</td>
      <td style="color:var(--gold);font-weight:600">Rs. ${Number(p.amount||0).toLocaleString()}</td>
      <td>${p.method||'Cash'}</td>
      <td>${p.propertyTitle||'—'}</td>
      <td>${p.screenshot ? `<a href="${p.screenshot}" target="_blank">View</a>` : '—'}</td>
      <td>${p.paidAt?new Date(p.paidAt).toLocaleDateString('en-PK',{day:'numeric',month:'short',year:'numeric'}):'—'}</td>
      <td><span class="badge ${p.status==='paid'?'b-green':p.status==='overdue'||p.status==='rejected'?'b-red':'b-warn'}">${p.status||'pending'}</span></td>
    </tr>`).join('');
  } catch { tbody.innerHTML = '<tr><td colspan="7" class="loading">⚠️ Error loading.</td></tr>'; }
}
async function submitPayment() {
  const amount = document.getElementById('pamt')?.value;
  const month  = document.getElementById('pmon')?.value?.trim();
  const method = document.getElementById('pmth')?.value;
  const note   = document.getElementById('pnot')?.value?.trim();
  const propId = document.getElementById('pprop')?.value?.trim();
  const screenshotInput = document.getElementById('pscreenshot');
  if (!amount || !month) { alert('Amount and month are required.'); return; }
  const btn = document.getElementById('psubmit-btn');
  if(btn){btn.disabled=true;btn.textContent='Saving…';}
  try {
    let landlordId = '';
    let landlordName = '';
    let propertyId = propId || '';
    let propertyTitle = '';
    
    // First try to get from selected property
    if (propId && window._tenantPropMap) {
      const selectedProp = window._tenantPropMap[propId];
      if (selectedProp) {
        landlordId = selectedProp.landlordId || '';
        landlordName = selectedProp.landlordName || '';
        propertyTitle = selectedProp.title || '';
      }
    }
    
    // Fallback to lease data if no property selected or property not found
    if (!landlordId || !landlordName) {
      const leaseData = await tFetch('/leases');
      const leases = leaseData.leases || [];
      if (leases.length) {
        if (!landlordId) landlordId = leases[0].landlordId || '';
        if (!landlordName) landlordName = leases[0].landlordName || '';
        if (!propertyId) propertyId = leases[0].propertyId || '';
        if (!propertyTitle) propertyTitle = leases[0].propertyTitle || '';
      }
    }
    
    let screenshot = '';
    if (screenshotInput?.files?.length) {
      screenshot = await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = () => reject(reader.error);
        reader.readAsDataURL(screenshotInput.files[0]);
      });
    }
    const r = await tFetch('/payments','POST',{amount:Number(amount), month, method, note, landlordId, landlordName, propertyId, propertyTitle, screenshot});
    if (r.success) {
      document.getElementById('pamt').value = ''; document.getElementById('pmon').value = ''; document.getElementById('pnot').value = ''; document.getElementById('pprop').value = '';
      if (screenshotInput) screenshotInput.value = '';
      const toast = document.getElementById('pok'); if(toast){toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),3000);}
      await loadPayments();
    } else alert(r.message||'Failed.');
  } catch (err) {
    console.error('submitPayment error', err);
    alert('Cannot connect to server.');
  }
  finally { if(btn){btn.disabled=false;btn.textContent='Record Payment';} }
}

// ═══════════════════════════════════════════════════════
//  LEASE AGREEMENT
// ═══════════════════════════════════════════════════════
async function loadLease() {
  const box = document.getElementById('lease-display');
  if (!box) return;
  const user = JSON.parse(localStorage.getItem('tms_user')||'{}');
  try {
    const data = await tFetch('/leases');
    const leases = data.leases || [];
    const activeLeases = leases.filter(x => x.status === 'active');
    const pendingLeases = leases.filter(x => x.status === 'pending');
    const l = activeLeases.length ? activeLeases[0] : pendingLeases.length ? pendingLeases[0] : null;

    if (l) {
      // Store current lease in window for editing
      window._currentLease = l;
      const signedDate = new Date(l.signedAt||l.createdAt).toLocaleDateString('en-PK',{day:'numeric',month:'long',year:'numeric'});
      const statusColor = l.status==='active' ? '#22c55e' : l.status==='pending' ? '#f59e0b' : '#6b7280';
      
      box.innerHTML = `
        <div class="lease-box" style="border:none;padding:0">
          <!-- Document Header -->
          <div style="background:linear-gradient(135deg,rgba(201,169,110,0.08) 0%,rgba(201,169,110,0.02) 100%);border:1px solid rgba(201,169,110,0.15);border-radius:18px;padding:28px 30px;margin-bottom:16px">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:12px">
              <div>
                <div style="font-family:'Cormorant Garamond','Playfair Display',serif;font-size:28px;font-weight:700;color:var(--text);letter-spacing:-0.3px">Tenancy Agreement</div>
                <div style="font-size:11px;color:var(--muted);margin-top:4px;letter-spacing:0.8px;text-transform:uppercase;font-weight:600">Punjab Rented Premises Act 2009 — TMS Platform</div>
              </div>
              <div style="text-align:right">
                <div style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.6px;font-weight:700">Agreement Status</div>
                <div style="margin-top:4px;padding:5px 14px;border-radius:20px;font-size:12px;font-weight:700;background:${statusColor}18;color:${statusColor};border:1px solid ${statusColor}33;display:inline-block">${(l.status||'active').toUpperCase()}</div>
                <div style="font-size:11px;color:var(--muted);margin-top:6px">Executed: ${signedDate}</div>
              </div>
            </div>
            <!-- Parties Grid -->
            <div style="display:grid;grid-template-columns:1fr 1px 1fr;gap:0;background:var(--card);border:1px solid rgba(201,169,110,0.12);border-radius:12px;overflow:hidden">
              <div style="padding:16px 18px">
                <div style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.8px;font-weight:700;margin-bottom:8px">🔑 LANDLORD (Lessor)</div>
                <div style="font-size:15px;font-weight:700;color:var(--text);margin-bottom:3px">${l.landlordName||'—'}</div>
                <div style="font-size:12px;color:var(--muted)">Property Owner</div>
              </div>
              <div style="background:rgba(201,169,110,0.12)"></div>
              <div style="padding:16px 18px">
                <div style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.8px;font-weight:700;margin-bottom:8px">🏠 TENANT (Lessee)</div>
                <div style="font-size:15px;font-weight:700;color:var(--text);margin-bottom:3px">${l.tenantName||user.name||'—'}</div>
                <div style="font-size:12px;color:var(--muted)">Resident Occupant</div>
              </div>
            </div>
          </div>

          <!-- Key Terms Summary -->
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin-bottom:16px">
            ${[
              {icon:'📍',label:'Property',val:l.propertyTitle||'—'},
              {icon:'🗺️',label:'Address',val:l.propertyAddress||'—'},
              {icon:'💰',label:'Monthly Rent',val:'Rs. '+Number(l.rent||0).toLocaleString(),highlight:true},
              {icon:'📅',label:'Commencement',val:l.startDate||'—'},
              {icon:'📅',label:'Expiry',val:l.endDate||'—'},
              {icon:'⏱️',label:'Duration',val:l.duration||'11 months'},
            ].map(item=>`
              <div style="background:var(--card);border:1px solid rgba(201,169,110,0.1);border-radius:12px;padding:14px 15px">
                <div style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.6px;font-weight:700;margin-bottom:6px">${item.icon} ${item.label}</div>
                <div style="font-size:14px;font-weight:700;color:${item.highlight?'var(--blue)':'var(--text)'}">${item.val}</div>
              </div>
            `).join('')}
          </div>

          <!-- Signature Section -->
          <div style="background:var(--card);border:1px solid rgba(201,169,110,0.12);border-radius:14px;padding:20px;margin-bottom:16px">
            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:var(--muted);margin-bottom:14px">✍️ Execution & Signatures</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
              <div style="border:1px dashed rgba(201,169,110,0.25);border-radius:10px;padding:14px;text-align:center">
                <div style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.6px;font-weight:700;margin-bottom:8px">Landlord Signature</div>
                ${l.landlordSignature ? `<img src="${l.landlordSignature}" style="max-width:160px;max-height:60px;object-fit:contain">` : `<div style="height:55px;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:12px">Pending signature</div>`}
                <div style="font-size:11px;color:var(--muted);margin-top:8px;padding-top:8px;border-top:1px solid var(--border)">${l.landlordName||'Landlord'}</div>
              </div>
              <div style="border:1px dashed rgba(74,158,255,0.3);border-radius:10px;padding:14px;text-align:center">
                <div style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.6px;font-weight:700;margin-bottom:8px">Tenant Signature</div>
                ${l.tenantSignature ? `<img src="${l.tenantSignature}" style="max-width:160px;max-height:60px;object-fit:contain">` : `<div style="height:55px;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:12px">Not yet signed</div>`}
                <div style="font-size:11px;color:var(--muted);margin-top:8px;padding-top:8px;border-top:1px solid var(--border)">${l.tenantName||user.name||'Tenant'}</div>
              </div>
            </div>
            ${!l.tenantSignature ? `<button onclick="openSignaturePad('${l._id}')" style="width:100%;margin-top:12px;padding:11px;border-radius:10px;border:none;background:linear-gradient(135deg,var(--blue),#2563eb);color:#fff;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:700;cursor:pointer;letter-spacing:0.1px">✍️ Sign This Agreement</button>` : `<div style="margin-top:10px;padding:10px 14px;background:rgba(34,197,94,0.08);border:1px solid rgba(34,197,94,0.2);border-radius:9px;font-size:12px;color:#22c55e;font-weight:600;text-align:center">✅ Agreement Digitally Signed by Tenant on ${signedDate}</div>`}
          </div>

          <!-- Action Buttons -->
          <div style="display:flex;gap:10px;flex-wrap:wrap">
            <button class="submit-btn" style="flex:1;min-width:130px" onclick="openLeaseDocumentModal()">📄 View Full Agreement</button>
            <button class="submit-btn" style="flex:1;min-width:130px;background:rgba(255,255,255,0.06);color:var(--text);box-shadow:none;border:1px solid var(--border)" onclick="toggleLeaseEdit()">✏️ Edit Details</button>
            <button onclick="printLeaseAgreement()" style="padding:11px 18px;border-radius:11px;border:1px solid rgba(201,169,110,0.25);background:rgba(201,169,110,0.08);color:var(--gold);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;cursor:pointer">🖨️ Print</button>
          </div>

          <div id="lease-edit-mode" style="display:none;margin-top:16px;background:var(--card);border:1px solid var(--border);border-radius:14px;padding:20px">
            <h3 style="margin-bottom:15px;color:var(--text);font-size:15px;font-weight:700">✏️ Edit Lease Details</h3>
            <div class="form-grid">
              <div class="fg"><label>Monthly Rent (Rs.)</label><input id="edit-rent" type="number" placeholder="25000" value="${l.rent||0}"></div>
              <div class="fg"><label>Start Date</label><input id="edit-start" type="date" value="${l.startDate||''}"></div>
              <div class="fg"><label>End Date</label><input id="edit-end" type="date" value="${l.endDate||''}"></div>
              <div class="fg"><label>Duration</label><input id="edit-duration" type="text" placeholder="11 months" value="${l.duration||'11 months'}"></div>
              <div class="fg full"><label>Terms & Conditions</label><textarea id="edit-terms" placeholder="Enter agreement terms..." style="min-height:120px;">${l.terms || getStandardLeaseTerms()}</textarea></div>
            </div>
            <div style="display:flex;gap:10px;margin-top:15px;">
              <button class="submit-btn" style="flex:1" onclick="saveLeaseChanges()">💾 Save Changes</button>
              <button class="submit-btn" style="flex:1;background:rgba(255,107,107,0.1);color:var(--error);box-shadow:none;border:1px solid rgba(255,107,107,0.2)" onclick="toggleLeaseEdit()">✕ Cancel</button>
            </div>
          </div>
        </div>
      `;
    } else {
      // Show agreement form to sign new
      box.innerHTML = `
        <div style="border:1px solid rgba(201,169,110,0.12);border-radius:18px;overflow:hidden">
          <!-- Header -->
          <div style="background:linear-gradient(135deg,rgba(201,169,110,0.07),rgba(201,169,110,0.02));padding:24px 26px;border-bottom:1px solid rgba(201,169,110,0.1)">
            <div style="font-family:'Cormorant Garamond','Playfair Display',serif;font-size:26px;font-weight:700;color:var(--text);margin-bottom:4px">Draft Tenancy Agreement</div>
            <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.8px;font-weight:600">Punjab Rented Premises Act 2009 — Compliant Template</div>
          </div>
          <div style="padding:22px 26px">
            <!-- Notice Banner -->
            <div style="background:rgba(74,158,255,0.07);border:1px solid rgba(74,158,255,0.18);border-radius:10px;padding:12px 15px;margin-bottom:20px;display:flex;gap:10px;align-items:flex-start">
              <span style="font-size:18px;flex-shrink:0">ℹ️</span>
              <div style="font-size:12px;color:var(--blue);line-height:1.6">This agreement is prepared in accordance with the <strong>Punjab Rented Premises Act 2009</strong>. An 11-month tenancy avoids mandatory registration under the Registration Act 1908. Digital signatures are legally recognized under the <strong>Electronic Transactions Ordinance 2002</strong>.</div>
            </div>
            <!-- Form -->
            <div class="form-grid">
              <div class="fg"><label>Property Title *</label><input id="la-title" placeholder="e.g. 3-Bed House, DHA Phase 5"></div>
              <div class="fg"><label>Full Address *</label><input id="la-addr" placeholder="Street, Block, City"></div>
              <div class="fg"><label>Landlord Full Name *</label><input id="la-ll" placeholder="As per CNIC"></div>
              <div class="fg"><label>Monthly Rent (Rs.) *</label><input id="la-rent" type="number" placeholder="25000"></div>
              <div class="fg"><label>Commencement Date *</label><input id="la-start" type="date"></div>
              <div class="fg"><label>Expiry Date *</label><input id="la-end" type="date"></div>
              <div class="fg full"><label>Duration</label><input id="la-dur" placeholder="11 months" value="11 months"></div>
              <div class="fg full"><label>Terms & Conditions (Pakistan Law Compliant)</label><textarea id="la-terms" style="min-height:200px;font-size:12px;line-height:1.7">${getStandardLeaseTerms()}</textarea></div>
            </div>
            <!-- Witness Notice -->
            <div style="background:rgba(201,169,110,0.06);border:1px solid rgba(201,169,110,0.15);border-radius:10px;padding:13px 15px;margin-top:16px;font-size:12px;color:var(--muted);line-height:1.7">
              <strong style="color:var(--gold)">📋 Legal Requirements:</strong> Under Pakistani tenancy law, this agreement requires signatures from: (1) <strong>Tenant</strong>, (2) <strong>Landlord</strong>, (3) <strong>Tenant's Witness</strong> (with CNIC), (4) <strong>Landlord's Witness</strong> (with CNIC). Both parties should retain a signed original. A Rs. 100 stamp paper is recommended.
            </div>
            <div style="display:flex;gap:10px;margin-top:18px;flex-wrap:wrap">
              <button class="submit-btn" style="flex:1;min-width:160px" onclick="signLease()">✍️ Create & Sign Agreement</button>
            </div>
            <div id="lease-ok" class="toast">✅ Lease agreement created successfully!</div>
          </div>
        </div>
      `;
    }
  } catch { box.innerHTML = '<div class="loading">⚠️ Error loading lease.</div>'; }
}

function toggleLeaseEdit() {
  const viewMode = document.getElementById('lease-view-mode');
  const editMode = document.getElementById('lease-edit-mode');
  if (viewMode && editMode) {
    const isEditing = editMode.style.display !== 'none';
    viewMode.style.display = isEditing ? 'block' : 'none';
    editMode.style.display = isEditing ? 'none' : 'block';
  }
}

async function saveLeaseChanges() {
  const leaseId = window._currentLease?._id || window._currentLease?.id;
  if (!leaseId) { alert('No lease found to update.'); return; }
  
  const rent = document.getElementById('edit-rent')?.value;
  const startDate = document.getElementById('edit-start')?.value;
  const endDate = document.getElementById('edit-end')?.value;
  const duration = document.getElementById('edit-duration')?.value?.trim();
  const terms = document.getElementById('edit-terms')?.value?.trim();
  
  if (!rent || !startDate || !endDate) {
    alert('Please fill in all required fields (Rent, Start Date, End Date).');
    return;
  }

  const existingLease = window._currentLease;
  if (existingLease?.status === 'active') {
    const currentEnd = new Date(existingLease.endDate || existingLease.startDate);
    const newEnd = endDate ? new Date(endDate) : null;
    if (!newEnd || newEnd <= currentEnd) {
      alert('Active lease cannot be modified until it expires. To update rent or terms, extend the lease end date first.');
      return;
    }
  }
  
  try {
    const payload = { rent: Number(rent), startDate, endDate, duration, terms };
    const r = await tFetch('/leases/' + encodeURIComponent(leaseId), 'PUT', payload);
    if (r.success) {
      alert('✅ Lease updated successfully!');
      await loadLease();
    } else {
      alert(r.message || 'Failed to update lease.');
    }
  } catch (e) {
    console.error(e);
    alert(e.message || 'Cannot connect to server.');
  }
}

function viewLeaseTerms() {
  const lease = window._currentLease;
  if (!lease) return;
  const terms = lease.terms?.trim() || getStandardLeaseTerms();
  alert(`Terms & Conditions:\n\n${terms}`);
}
function getStandardLeaseTerms() {
  return `1. Rent Payment\nTenant shall pay rent on time each month, for example by the 5th of every month. Late payments may attract a penalty.\n\n2. Security Deposit\nTenant shall provide a security deposit at the start of the agreement (typically 2–3 months' rent). The deposit will be refunded at the end of the tenancy if there is no damage beyond normal wear and tear.\n\n3. Agreement Duration\nThis agreement shall remain valid for ___ months/years (commonly 11 months). It may be renewed on mutually agreed terms upon expiry.\n\n4. Rent Increase\nRent may be increased by up to ___% at each renewal (usually 5–10%).\n\n5. Utility Bills\nThe tenant is responsible for payment of electricity, gas, water and all other utility bills. Any outstanding utility bills must be cleared by the tenant.\n\n6. Use of Property\nThe property shall be used for residential purposes only. No illegal activity is permitted.\n\n7. Maintenance & Repairs\nMinor repairs are the responsibility of the tenant. Major structural repairs remain the responsibility of the landlord.\n\n8. Subletting\nThe tenant shall not sublet the property without the landlord’s written permission.\n\n9. Damage to Property\nThe tenant shall not damage the property. Any damage caused by the tenant shall be repaired at the tenant’s cost.\n\n10. Inspection Rights\nThe landlord may inspect the property after giving prior notice.\n\n11. Termination Clause\nEither party may terminate this agreement by giving ___ days' notice (usually 30 days).\n\n12. Eviction\nFailure to pay rent or violation of the agreement may result in legal eviction proceedings by the landlord.\n\n13. Handover Condition\nThe tenant shall return the property in the same condition as received, allowing for normal wear and tear.\n\n14. Governing Law\nThis agreement is governed by the relevant rental laws of Pakistan, including applicable provisions of the Punjab Rented Premises Act 2009.\n\n15. Signatures\nSignatures of the landlord and tenant, plus two witnesses (one witness for the landlord and one witness for the tenant), are required.`;
}

async function signLease() {
  const title = document.getElementById('la-title')?.value?.trim();
  const addr  = document.getElementById('la-addr')?.value?.trim();
  const ll    = document.getElementById('la-ll')?.value?.trim();
  const rent  = document.getElementById('la-rent')?.value;
  const start = document.getElementById('la-start')?.value;
  const end   = document.getElementById('la-end')?.value;
  const dur   = document.getElementById('la-dur')?.value?.trim();
  const terms = document.getElementById('la-terms')?.value?.trim();
  if (!title || !rent || !terms) { alert('Property title, rent, and terms are required.'); return; }
  try {
    const payload = { propertyTitle:title, propertyAddress:addr, landlordName:ll, rent:Number(rent), startDate:start, endDate:end, duration:dur, terms };
    const lookup = (v) => (v||'').trim().toLowerCase();
    const normalizedTitle = lookup(title);
    const normalizedAddr = lookup(addr);
    const normalizedLandlord = lookup(ll);
    const matched = Object.values(window._tenantPropMap || {}).find(p => {
      const pTitle = lookup(p.title);
      const pAddr  = lookup(p.address);
      const pLand  = lookup(p.landlordName);
      return pTitle === normalizedTitle || pAddr === normalizedAddr || p._id === title || p._id === addr || (normalizedLandlord && pLand === normalizedLandlord);
    });
    if (matched) {
      payload.landlordId = matched.landlordId;
      payload.propertyId = matched._id;
    }
    const r = await tFetch('/leases','POST', payload);
    if (r.success) {
      await loadLease();
    } else alert(r.message||'Failed.');
  } catch { alert('Cannot connect to server.'); }
}

// ═══════════════════════════════════════════════════════
//  NOTIFICATIONS (static for now — can be extended)
// ═══════════════════════════════════════════════════════
function loadNotifications() {
  if (typeof tmsRenderNotifs === 'function') {
    tmsRenderNotifs();
  } else {
    const container = document.getElementById('notifs-list');
    if (container) {
      container.innerHTML = `<div style="text-align:center;padding:40px;color:var(--muted)">Notifications are unavailable right now.</div>`;
    }
  }
  // Mark all read and hide badge
  if (typeof TMS !== 'undefined') {
    TMS.markAllNotifsRead();
    const nb = document.getElementById('nb'); if(nb) nb.style.display='none';
    const nb2 = document.getElementById('nb2'); if(nb2) nb2.style.display='none';
  }
}

// ═══════════════════════════════════════════════════════
//  PROFILE
// ═══════════════════════════════════════════════════════
async function saveProfile() {
  const user = JSON.parse(localStorage.getItem('tms_user')||'{}');
  const fn = document.getElementById('pfn')?.value||'';
  const ln = document.getElementById('pln')?.value||'';
  const ph = document.getElementById('pph')?.value||'';
  const ct = document.getElementById('pct')?.value||'';
  const cn = document.getElementById('pcn')?.value||'';
  const name = (fn+' '+ln).trim();
  const btn = document.getElementById('save-profile-btn');
  if(btn){btn.disabled=true;btn.textContent='Saving…';}
  try {
    await tFetch('/auth/profile','PUT',{name, phone:ph, city:ct, cnic:cn});
    const updated = {...user, name, phone:ph, city:ct, cnic:cn};
    localStorage.setItem('tms_user', JSON.stringify(updated));
    const toast = document.getElementById('sok'); if(toast){toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),2500);}
    ['pav','sav'].forEach(id => { const e=document.getElementById(id); if(e) e.textContent=name.split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase(); });
    ['pdn','sdn'].forEach(id => { const e=document.getElementById(id); if(e) e.textContent=name; });
  } catch { alert('Error saving profile.'); }
  finally { if(btn){btn.disabled=false;btn.textContent='💾 Save Changes';} }
}

// ═══════════════════════════════════════════════════════
//  3D MODAL
// ═══════════════════════════════════════════════════════
function open3D(id, name, model3dOrJson, type) {
  const viewerCfg = parseViewerConfig(model3dOrJson);
  if (!viewerCfg.panoramaUrl) {
    alert('3D view is not yet available for this property. Please wait for admin approval.');
    return;
  }
  if (!viewerCfg.panoramaUrl) {
    alert('3D view is not yet available for this property. Please wait for admin approval.');
    return;
  }
  document.getElementById('ov3d').classList.add('open');
  document.getElementById('m3dn').textContent = (name || 'Property') + ' — Full Opening 360 View';
  document.body.style.overflow = 'hidden';
  const loadingEl = document.getElementById('c3main-loading');
  if (loadingEl) loadingEl.style.display = 'flex';
  const viewer = document.getElementById('c3main-viewer');
  if (viewer) {
    viewer.src = viewerCfg.panoramaUrl;
    viewer.onload = function() {
      if (loadingEl) loadingEl.style.display = 'none';
    };
    setTimeout(() => { if (loadingEl) loadingEl.style.display = 'none'; }, 5000);
  }
}
function tenantView3D(propId) {
  const p = (window._tenantPropMap||{})[propId]; if(!p) return;
  const panoramaUrl = getProperty360Url(p);
  if (!panoramaUrl) {
    return alert('3D view is pending admin approval for this property.');
  }
  open3D(propId, p.title, p.model3d, p.type);
}
function c3d() {
  document.getElementById('ov3d')?.classList.remove('open');
  document.body.style.overflow = '';
}

// ═══════════════════════════════════════════════════════
//  TENANT FURNITURE PLACEMENT
// ═══════════════════════════════════════════════════════
function tenantOpenFurniture(propId, showLandlord) {
  const p = (window._tenantPropMap||{})[propId]; if(!p) return;
  window._tFurnPropId      = propId;
  window._tFurnPropTitle   = p.title || 'Property';
  window._tFurnProp        = p;
  window._tFurnShowingLandlord = !!showLandlord;

  const tenantLayout   = p.tenantFurnitureLayout   || {};
  const landlordLayout = p.landlordFurnitureLayout  || {};
  const hasTenant   = Object.keys(tenantLayout).length   > 0;
  const hasLandlord = Object.keys(landlordLayout).length > 0;

  const savedLayout = showLandlord ? landlordLayout : tenantLayout;
  const badge = document.getElementById('tfurn-saved-badge');
  const toggleBtn = document.getElementById('tfurn-toggle-btn');
  const saveBtnEl = document.getElementById('tfurn-save-btn');

  if (showLandlord) {
    document.getElementById('ov-tfurn-title').textContent = '🏠 ' + window._tFurnPropTitle + ' — Landlord Layout (View Only)';
    if (badge) { badge.style.display = hasLandlord ? 'flex' : 'none'; badge.textContent = '✅ Landlord Layout'; }
    if (saveBtnEl) saveBtnEl.style.display = 'none';
    if (toggleBtn) { toggleBtn.style.display = hasTenant ? 'flex' : 'none'; toggleBtn.textContent = '🛋️ My Layout'; }
  } else {
    document.getElementById('ov-tfurn-title').textContent = '🛋️ ' + window._tFurnPropTitle + ' — My Furniture Plan';
    if (badge) { badge.style.display = hasTenant ? 'flex' : 'none'; badge.textContent = '✅ Saved'; }
    if (saveBtnEl) saveBtnEl.style.display = '';
    if (toggleBtn) { toggleBtn.style.display = hasLandlord ? 'flex' : 'none'; toggleBtn.textContent = '🏠 Landlord Layout'; }
  }

  document.getElementById('ov-tfurn').classList.add('open');
  document.body.style.overflow = 'hidden';

  setTimeout(() => {
    if (typeof initFurniturePlacement === 'function') {
      const sc = initFurniturePlacement('c3d-tfurn', savedLayout, null);
      window._tFurnScene = sc;
    }
  }, 150);
}
function tFurnToggleView() {
  const pid = window._tFurnPropId;
  const showing = window._tFurnShowingLandlord;
  tenantOpenFurniture(pid, !showing);
}
function closeTFurnViewer() {
  document.getElementById('ov-tfurn')?.classList.remove('open');
  document.body.style.overflow = '';
}
async function saveTenantFurnitureLayout() {
  const sc = window._tFurnScene;
  if (!sc) return;
  const layout = sc.getLayout();
  const btn = document.getElementById('tfurn-save-btn');
  if (btn) { btn.disabled=true; btn.textContent='Saving…'; }
  try {
    await tFetch('/properties/'+window._tFurnPropId+'/furniture/tenant', 'PUT', layout);
    const toast = document.getElementById('tfurn-saved-toast');
    if (toast) { toast.style.display='flex'; setTimeout(()=>toast.style.display='none',2500); }
    const badge = document.getElementById('tfurn-saved-badge');
    if (badge) badge.style.display = 'flex';
    // Refresh property map so re-open shows saved layout
    const data = await tFetch('/properties?status=available');
    allProps = data.properties || [];
    window._tenantPropMap = {};
    allProps.forEach(p => { window._tenantPropMap[p._id] = p; });
  } catch(e) { alert('Layout save nahi ho saka.'); }
  finally { if(btn){btn.disabled=false;btn.textContent='💾 Save Layout';} }
}
function tFurnAddItem(type, color) {
  const sc = window._tFurnScene;
  if (sc) sc.addFurniture(type, parseInt((color||'#888888').replace('#',''),16));
}
function tFurnRotate(deg) { const sc=window._tFurnScene; if(sc) sc.rotateSelected(deg); }
function tFurnDelete()    { const sc=window._tFurnScene; if(sc) sc.deleteSelected(); }
function tFurnDownloadPNG()  { if(typeof downloadFurnitureScreenshot==='function') downloadFurnitureScreenshot('c3d-tfurn', window._tFurnPropTitle+'-my-layout'); }
function tFurnDownloadJSON() { if(typeof downloadFurnitureJSON==='function') downloadFurnitureJSON('c3d-tfurn', window._tFurnPropTitle, 'tenant'); }
</script>

<div class="bg"></div>

<!-- TOP NAV -->
<nav class="topnav">
  <div class="topnav-logo">
    <div class="logo-icon"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
    <span class="logo-text">TMS</span><span class="logo-sep" style="margin:0 4px">/</span><span style="font-size:12px;color:var(--muted)">Tenant</span>
  </div>
  <span class="nav-pill">🏠 Tenant Portal</span>
  <button class="icon-btn" onclick="sp('notifications',null)" title="Notifications">🔔<span class="notif-badge" id="nb" style="display:none">0</span></button>
  <button class="icon-btn" id="theme-btn" onclick="toggleTheme()" title="Toggle Theme">🌙</button>
  <button class="logout-btn" onclick="tmsLogout()">
    <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>Logout
  </button>
</nav>

<div class="body-wrap">
<!-- SIDEBAR -->
<aside class="sidebar">
