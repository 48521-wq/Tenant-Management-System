      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>Find Properties
    </button>
    <button class="nav-item" onclick="sp('profile',this)">
      <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>My Profile
    </button>
  </div>
  <div class="sidebar-section">
    <div class="sidebar-label">Property</div>
    <button class="nav-item" onclick="sp('furniture',this)">
      <svg viewBox="0 0 24 24"><path d="M2 9V7a2 2 0 012-2h16a2 2 0 012 2v2"/><path d="M2 9h20v11H2z"/><line x1="6" y1="9" x2="6" y2="20"/><line x1="18" y1="9" x2="18" y2="20"/></svg>Furniture Placement
    </button>
    <button class="nav-item" onclick="sp('agreement',this)">
      <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Lease Agreement
    </button>
    <button class="nav-item" onclick="sp('payments',this)">
      <svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>Payment Records
    </button>
  </div>
  <div class="sidebar-section">
    <div class="sidebar-label">Support</div>
    <button class="nav-item" onclick="sp('maintenance',this)">
      <svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>Maintenance
    </button>
    <button class="nav-item" onclick="sp('complaints',this)">
      <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>Complaints
    </button>
    <button class="nav-item" onclick="sp('rental-requests',this)">
      <svg viewBox="0 0 24 24"><path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"/><polyline points="9 12 12 15 16 11"/></svg>Rental Requests
      <span class="nb-pill" id="rental-requests-badge" style="display:none">0</span>
    </button>
    <button class="nav-item" onclick="sp('notifications',this)">
      <svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>Notifications
      <span class="nb-pill" id="nb2" style="display:none">0</span>
    </button>
  </div>
  <div class="sidebar-foot">
    <div class="user-card">
      <div class="uav" id="sav">T</div>
      <div><div class="u-name" id="sdn">Tenant</div><div class="u-role" id="sde">tenant</div></div>
    </div>
  </div>
</aside>

<!-- MAIN CONTENT -->
<main class="main">

  <!-- FIND PROPERTIES -->
  <div class="page active" id="page-search">
    <div class="pg-head">
      <div><div class="pg-title">Find Your Perfect Home</div><div class="pg-sub">Browse and filter available properties</div></div>
      <span style="background:var(--card);border:1px solid var(--border);padding:6px 14px;border-radius:20px;font-size:13px;color:var(--blue);font-weight:600"><span id="rc">0</span> Properties</span>
    </div>
    <div class="filter-bar">
      <div class="fgrp">
        <span class="flbl">📍 Area</span>
        <select class="fsel" id="fa">
          <option value="">All Areas</option>
          <option>DHA Lahore</option><option>Johar Town</option><option>Gulberg</option>
          <option>Bahria Town</option><option>Model Town</option><option>Garden Town</option><option>Cantt</option>
        </select>
      </div>
      <div class="fgrp">
        <span class="flbl">🏠 Type</span>
        <select class="fsel" id="ft">
          <option value="">All Types</option>
          <option>House</option><option>Flat</option><option>Apartment</option><option>Villa</option><option>Room</option>
        </select>
      </div>
      <div class="fgrp">
        <span class="flbl">🛏 Min Beds</span>
        <select class="fsel" id="fb">
          <option value="">Any</option><option value="1">1+</option><option value="2">2+</option><option value="3">3+</option><option value="4">4+</option>
        </select>
      </div>
      <div class="fgrp">
        <span class="flbl">💰 Max Rent</span>
        <input class="finp" type="number" id="fm" placeholder="e.g. 50000">
      </div>
      <button class="search-btn" onclick="applyFilters()">Search</button>
    </div>
    <div class="props-grid" id="props-grid"><div class="loading"><span class="spinner"></span>Loading…</div></div>
  </div>

  <!-- PROFILE -->
  <div class="page" id="page-profile">
    <div class="pg-head"><div><div class="pg-title">My Profile</div><div class="pg-sub">Manage your personal information</div></div></div>
    <div>
      <div class="profile-header">
        <div class="profile-av" id="pav">T</div>
        <div class="profile-av-info">
          <h3 id="pdn">Tenant</h3>
          <p id="pde">tenant@email.com</p>
          <span class="badge b-blue" style="margin-top:6px">🏠 Tenant</span>
        </div>
      </div>
      <div class="form-card">
        <div class="form-grid">
          <div class="fg"><label>First Name</label><input id="pfn"></div>
          <div class="fg"><label>Last Name</label><input id="pln"></div>
          <div class="fg full"><label>Email</label><input id="pem" disabled style="opacity:0.6"></div>
          <div class="fg"><label>Phone</label><input id="pph" placeholder="+92 3XX XXXXXXX"></div>
          <div class="fg"><label>City</label><input id="pct" placeholder="Lahore"></div>
          <div class="fg full"><label>CNIC</label><input id="pcn" placeholder="XXXXX-XXXXXXX-X"></div>
        </div>
        <div style="display:flex;align-items:center;gap:12px;margin-top:16px">
          <button class="submit-btn" id="save-profile-btn" onclick="saveProfile()">💾 Save Changes</button>
          <div id="sok" class="toast" style="margin:0">✅ Profile saved!</div>
        </div>
      </div>
    </div>
  </div>

  <!-- FURNITURE PLACEMENT PAGE -->
  <div class="page" id="page-furniture">
    <div class="pg-head">
      <div><div class="pg-title">🛋️ Furniture Placement</div><div class="pg-sub">Design your room layout — add, move and save furniture</div></div>
    </div>

    <!-- Property selector -->
    <div style="margin-bottom:18px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">
      <label style="font-size:13px;font-weight:600;color:var(--muted)">Select Property:</label>
      <select id="furn-prop-select" onchange="loadFurnForProp(this.value)"
        style="padding:9px 16px;border-radius:10px;border:1px solid var(--border);background:var(--input-bg);color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;min-width:220px">
        <option value="">— Select a property —</option>
      </select>
      <div id="furn-page-saved-badge" style="display:none;padding:4px 12px;border-radius:20px;background:rgba(78,205,196,0.12);border:1px solid rgba(78,205,196,0.4);color:#4ECDC4;font-size:11px;font-weight:700">✅ Layout Saved</div>
      <button id="furn-page-toggle" onclick="furnPageToggleView()" style="display:none;padding:7px 16px;border-radius:9px;border:1px solid var(--gold);background:rgba(201,169,110,0.08);color:var(--gold);cursor:pointer;font-family:'DM Sans',sans-serif;font-size:12px;font-weight:600">🏠 View Landlord Layout</button>
    </div>

    <!-- 3D Canvas area -->
    <div id="furn-page-placeholder" style="display:flex;align-items:center;justify-content:center;min-height:420px;border-radius:16px;border:1px dashed var(--border);background:var(--input-bg);color:var(--muted);font-size:14px;flex-direction:column;gap:10px">
      <span style="font-size:48px">🛋️</span>
      <span>Property select karein upar se</span>
    </div>

    <div id="furn-page-main" style="display:none;flex-direction:column;gap:12px">
      <!-- Toolbar -->
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <div style="font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-right:4px">Add:</div>
        <div id="furn-page-catalog" style="display:flex;flex-wrap:wrap;gap:6px"></div>
      </div>
      <!-- Selected item controls -->
      <div id="furn-page-controls" style="display:none;align-items:center;gap:8px;flex-wrap:wrap;padding:10px 14px;border-radius:10px;background:var(--input-bg);border:1px solid var(--border)">
        <span style="font-size:12px;font-weight:600;color:var(--gold)">Selected:</span>
        <button onclick="furnPageRotate(-45)" style="padding:6px 12px;border-radius:7px;border:1px solid var(--border);background:var(--card);color:var(--text);cursor:pointer;font-size:12px;font-family:'DM Sans',sans-serif">↺ -45°</button>
        <button onclick="furnPageRotate(45)"  style="padding:6px 12px;border-radius:7px;border:1px solid var(--border);background:var(--card);color:var(--text);cursor:pointer;font-size:12px;font-family:'DM Sans',sans-serif">↻ +45°</button>
        <button onclick="furnPageRotate(90)"  style="padding:6px 12px;border-radius:7px;border:1px solid var(--border);background:var(--card);color:var(--text);cursor:pointer;font-size:12px;font-family:'DM Sans',sans-serif">↻ 90°</button>
        <button onclick="furnPageDelete()"    style="padding:6px 12px;border-radius:7px;border:1px solid rgba(255,107,107,0.3);background:rgba(255,107,107,0.08);color:#FF6B6B;cursor:pointer;font-size:12px;font-family:'DM Sans',sans-serif">🗑 Delete</button>
        <span style="font-size:11px;color:var(--muted);margin-left:8px">Right-drag: orbit · Scroll: zoom</span>
      </div>
      <!-- Canvas -->
      <div style="position:relative;border-radius:14px;overflow:hidden;border:1px solid var(--border)">
        <canvas id="c3d-furnpage" style="width:100%;height:520px;display:block;background:#1A1A2E;border-radius:10px"></canvas>
        <div id="furn-page-viewlabel" style="position:absolute;top:12px;left:14px;padding:4px 12px;border-radius:20px;background:rgba(0,0,0,0.6);font-size:11px;font-weight:700;color:#4ECDC4;display:none"></div>
      </div>
      <!-- Action buttons -->
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <button id="furn-page-save-btn" onclick="furnPageSave()" style="padding:10px 24px;border-radius:10px;background:linear-gradient(135deg,#4ECDC4,#2BB5AC);color:#fff;border:none;cursor:pointer;font-weight:600;font-family:'DM Sans',sans-serif;font-size:13px">💾 Save My Layout</button>
        <button onclick="furnPageDownloadPNG()"  style="padding:10px 18px;border-radius:10px;border:1px solid var(--border);background:var(--card);color:var(--text);cursor:pointer;font-family:'DM Sans',sans-serif;font-size:13px">📷 Download PNG</button>
        <button onclick="furnPageDownloadJSON()" style="padding:10px 18px;border-radius:10px;border:1px solid var(--border);background:var(--card);color:var(--text);cursor:pointer;font-family:'DM Sans',sans-serif;font-size:13px">⬇️ Download JSON</button>
      </div>
    </div>
  </div>

  <!-- LEASE AGREEMENT -->
  <div class="page" id="page-agreement">
    <div class="pg-head"><div><div class="pg-title">Lease Agreement</div><div class="pg-sub">Your rental contract</div></div></div>
    <div id="lease-display"><div class="loading"><span class="spinner"></span>Loading…</div></div>
  </div>

  <!-- PAYMENTS -->
  <div class="page" id="page-payments">
    <div class="pg-head"><div><div class="pg-title">Payment Records</div><div class="pg-sub">Track your rent payments</div></div></div>
    <div class="stat-row" id="pay-stats"></div>
    <div class="card" style="margin-bottom:20px">
      <h3 style="font-size:15px;font-weight:700;margin-bottom:16px;color:var(--text)">➕ Record New Payment</h3>
      <div class="form-grid">
        <div class="fg full"><label>Select Property</label>
          <select id="pprop" onchange="updatePaymentPropertyInfo()">
            <option value="">-- Select Property --</option>
          </select>
        </div>
        <div class="fg"><label>Month</label><input id="pmon" placeholder="e.g. March 2026"></div>
        <div class="fg"><label>Amount (Rs.)</label><input id="pamt" type="number" placeholder="25000"></div>
        <div class="fg"><label>Payment Method</label>
          <select id="pmth"><option>Cash</option><option>Bank Transfer</option><option>JazzCash</option><option>EasyPaisa</option><option>Cheque</option><option>Other</option></select>
        </div>
        <div class="fg"><label>Note (optional)</label><input id="pnot" placeholder="e.g. Paid via bank"></div>
        <div class="fg full"><label>Payment Screenshot</label><input type="file" id="pscreenshot" accept="image/*"></div>
      </div>
      <div style="display:flex;align-items:center;gap:12px;margin-top:14px">
        <button class="submit-btn" id="psubmit-btn" onclick="submitPayment()">💳 Record Payment</button>
        <div id="pok" class="toast" style="margin:0">✅ Payment recorded!</div>
      </div>
    </div>
    <div class="card">
      <h3 style="font-size:15px;font-weight:700;margin-bottom:4px;color:var(--text)">Payment History</h3>
      <div class="tbl-wrap">
        <table>
          <thead><tr><th>Month</th><th>Amount</th><th>Method</th><th>Property</th><th>Receipt</th><th>Date</th><th>Status</th></tr></thead>
          <tbody id="pay-tbody"><tr><td colspan="7" class="loading">Loading…</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- MAINTENANCE -->
  <div class="page" id="page-maintenance">
    <div class="pg-head"><div><div class="pg-title">Maintenance Requests</div><div class="pg-sub">Report and track repair requests</div></div></div>
    <div class="form-card" style="margin-bottom:20px">
      <h3 style="font-size:15px;font-weight:700;margin-bottom:16px;color:var(--text)">🔧 New Maintenance Request</h3>
      <div class="form-grid">
        <div class="fg full"><label>Select Property</label>
          <select id="mprop"><option value="">-- Select Property --</option></select>
        </div>
        <div class="fg"><label>Issue Type</label>
          <select id="mt"><option>Plumbing</option><option>Electrical</option><option>Gas</option><option>AC / Cooling</option><option>Painting</option><option>Structural</option><option>Other</option></select>
        </div>
        <div class="fg"><label>Priority</label>
          <select id="mp"><option value="low">Low</option><option value="medium" selected>Medium</option><option value="high">High</option><option value="urgent">Urgent</option></select>
        </div>
        <div class="fg full"><label>Description</label><textarea id="md" placeholder="Describe the problem in detail…" rows="3"></textarea></div>
      </div>
      <div style="display:flex;align-items:center;gap:12px;margin-top:14px">
        <button class="submit-btn" id="msubmit-btn" onclick="submitMaint()">📤 Submit Request</button>
        <div id="mok" class="toast" style="margin:0">✅ Request submitted!</div>
      </div>
    </div>
    <div class="card">
      <h3 style="font-size:15px;font-weight:700;margin-bottom:12px;color:var(--text)">My Requests</h3>
      <div id="maint-list"><div class="loading"><span class="spinner"></span>Loading…</div></div>
    </div>
  </div>

  <!-- COMPLAINTS -->
  <div class="page" id="page-complaints">
    <div class="pg-head"><div><div class="pg-title">Complaints</div><div class="pg-sub">File and track your complaints</div></div></div>
    <div class="form-card" style="margin-bottom:20px">
      <h3 style="font-size:15px;font-weight:700;margin-bottom:16px;color:var(--text)">📝 New Complaint</h3>
      <div class="form-grid">
        <div class="fg full"><label>Select Property</label>
          <select id="cprop"><option value="">-- Select Property --</option></select>
        </div>
        <div class="fg"><label>Category</label>
          <select id="cc"><option>Noise</option><option>Water</option><option>Electricity</option><option>Neighbor</option><option>Rent</option><option>Security</option><option>Other</option></select>
        </div>
        <div class="fg"><label>Subject</label><input id="cs" placeholder="Brief subject line"></div>
        <div class="fg full"><label>Description</label><textarea id="cd" placeholder="Describe your complaint in detail…" rows="3"></textarea></div>
      </div>
      <div style="display:flex;align-items:center;gap:12px;margin-top:14px">
        <button class="submit-btn" id="csubmit-btn" onclick="submitComp()">📤 Submit Complaint</button>
        <div id="cok" class="toast" style="margin:0">✅ Complaint submitted!</div>
      </div>
    </div>
    <div class="card">
      <h3 style="font-size:15px;font-weight:700;margin-bottom:12px;color:var(--text)">My Complaints</h3>
      <div id="comp-list"><div class="loading"><span class="spinner"></span>Loading…</div></div>
    </div>
  </div>

  <!-- RENTAL REQUESTS -->
  <div class="page" id="page-rental-requests">
    <div class="pg-head"><div><div class="pg-title">🤝 Rental Requests</div><div class="pg-sub">Track your property rental requests</div></div></div>
    <div class="card">
      <h3 style="font-size:15px;font-weight:700;margin-bottom:12px;color:var(--text)">My Requests</h3>
      <div id="rental-requests-list"><div class="loading"><span class="spinner"></span>Loading your rental requests…</div></div>
    </div>
  </div>

  <!-- NOTIFICATIONS -->
  <div class="page" id="page-notifications">
    <div class="pg-head">
      <div><div class="pg-title">Notifications</div><div class="pg-sub">Your recent updates</div></div>
    </div>
    <div class="card" style="margin-bottom:18px;">
      <div style="display:grid;gap:14px">
        <div style="display:grid;grid-template-columns:1fr 160px;gap:14px;align-items:end">
          <div class="fg" style="margin-bottom:0">
            <label>Title</label>
            <input id="notif-title" placeholder="Notification title" type="text">
          </div>
          <div class="fg" style="margin-bottom:0">
            <label>Send to</label>
            <select id="notif-to">
              <option value="all">Everyone</option>
              <option value="tenant">Tenants</option>
              <option value="landlord">Landlords</option>
              <option value="admin">Admin</option>
            </select>
          </div>
        </div>
        <div class="fg full" style="margin-bottom:0">
          <label>Message</label>
          <textarea id="notif-msg" placeholder="Write your notification message..."></textarea>
        </div>
        <div style="display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap">
          <button class="submit-btn" onclick="tmsSendNotification()">Send Notification</button>
          <span id="notif-ok" class="toast">Notification sent!</span>
        </div>
      </div>
    </div>
    <div id="notifs-list"></div>
  </div>

</main>
</div>

<div class="ov" id="ov3d">
  <div class="ov-box">
    <div class="ov-head">
      <span class="ov-title" id="m3dn">360 View</span>
      <div style="display:flex;gap:6px;align-items:center">
        <button class="close-btn" onclick="c3d()">✕</button>
      </div>
    </div>
    <div style="width:100%;height:480px;background:#0a0d16;position:relative">
      <iframe
        id="c3main-viewer"
        src="https://kuula.co/share/54YJg/collection/7FbtP?fs=1&vr=0&sd=1&initload=1"
        title="Property 360 Interior"
        allowfullscreen
        allow="xr-spatial-tracking; gyroscope; accelerometer"
        referrerpolicy="strict-origin-when-cross-origin"
        style="width:100%;height:100%;background:#0a0d16;border:0"
      ></iframe>
      <div id="c3main-loading" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#0a0d16;flex-direction:column;gap:10px;pointer-events:none">
        <div style="width:36px;height:36px;border:3px solid rgba(201,169,110,0.3);border-top-color:#C9A96E;border-radius:50%;animation:spin 0.8s linear infinite"></div>
        <span style="color:#C9A96E;font-size:12px;font-weight:600">Loading 360 View...</span>
      </div>
    </div>
    <div style="padding:8px 16px;font-size:11px;color:var(--muted);text-align:center;border-top:1px solid var(--border)">Drag inside the viewer to move around just like the Kuula link.</div>
  </div>
</div>

<!-- TENANT FURNITURE PLACEMENT MODAL -->
<div class="ov" id="ov-tfurn">
  <div class="ov-box" style="width:min(1150px,99vw);max-height:97vh;overflow:hidden;display:flex;flex-direction:column">
    <!-- Header -->
    <div class="ov-head" style="flex-shrink:0;gap:10px;flex-wrap:wrap">
      <div style="display:flex;align-items:center;gap:10px;min-width:0">
        <span class="ov-title" id="ov-tfurn-title" style="font-size:15px">My Furniture Plan</span>
        <span id="tfurn-saved-badge" style="display:none;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;background:rgba(78,205,196,0.12);border:1px solid rgba(78,205,196,0.4);color:#4ECDC4;font-size:10px;font-weight:700">✅ Layout Saved</span>
      </div>
      <div style="display:flex;gap:6px;align-items:center;flex-shrink:0;flex-wrap:wrap">
        <div id="tfurn-saved-toast" style="display:none;align-items:center;gap:6px;padding:5px 12px;border-radius:8px;background:rgba(78,205,196,0.15);border:1px solid #4ECDC4;color:#4ECDC4;font-size:12px;font-weight:700">✅ Saved!</div>
        <button id="tfurn-toggle-btn" onclick="tFurnToggleView()" style="display:none;padding:7px 14px;border-radius:9px;border:1px solid var(--gold);background:rgba(201,169,110,0.1);color:var(--gold);cursor:pointer;font-family:'DM Sans',sans-serif;font-size:12px;font-weight:600">🏠 Landlord Layout</button>
        <button onclick="tFurnDownloadPNG()"  style="padding:7px 14px;border-radius:9px;border:1px solid var(--border);background:var(--card);color:var(--text);cursor:pointer;font-family:'DM Sans',sans-serif;font-size:12px">📷 PNG</button>
        <button onclick="tFurnDownloadJSON()" style="padding:7px 14px;border-radius:9px;border:1px solid var(--border);background:var(--card);color:var(--text);cursor:pointer;font-family:'DM Sans',sans-serif;font-size:12px">⬇️ JSON</button>
        <button id="tfurn-save-btn" class="btn" onclick="saveTenantFurnitureLayout()" style="padding:8px 18px;font-size:13px;background:linear-gradient(135deg,#4ECDC4,#2BB5AC);color:#fff;border:none;border-radius:10px;cursor:pointer;font-weight:600;font-family:'DM Sans',sans-serif">💾 Save Layout</button>
        <button class="close-btn" onclick="closeTFurnViewer()">✕</button>
      </div>
    </div>
    <!-- Body -->
    <div style="display:flex;flex:1;min-height:0;overflow:hidden">
      <!-- Sidebar -->
      <div style="width:195px;flex-shrink:0;padding:12px 8px;overflow-y:auto;border-right:1px solid var(--border);background:var(--input-bg);display:flex;flex-direction:column;gap:0">
        <div style="font-size:10px;font-weight:700;color:#4ECDC4;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;padding:0 4px">🏠 Tenant Layout</div>
        <div style="font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;padding:0 4px">Add Furniture</div>
        <div style="display:flex;flex-direction:column;gap:5px" id="tfurn-catalog"></div>
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border)">
          <div style="font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">Selected Item</div>
          <div id="tfurn-action-panel" style="display:none;flex-direction:column;gap:5px">
            <button onclick="tFurnRotate(-45)" style="padding:6px;border-radius:7px;border:1px solid var(--border);background:var(--card);color:var(--text);cursor:pointer;font-size:11px;font-family:'DM Sans',sans-serif">↺ -45°</button>
            <button onclick="tFurnRotate(45)"  style="padding:6px;border-radius:7px;border:1px solid var(--border);background:var(--card);color:var(--text);cursor:pointer;font-size:11px;font-family:'DM Sans',sans-serif">↻ +45°</button>
            <button onclick="tFurnRotate(90)"  style="padding:6px;border-radius:7px;border:1px solid var(--border);background:var(--card);color:var(--text);cursor:pointer;font-size:11px;font-family:'DM Sans',sans-serif">↻ 90°</button>
            <button onclick="tFurnDelete()"    style="padding:6px;border-radius:7px;border:1px solid rgba(255,107,107,0.3);background:rgba(255,107,107,0.08);color:#FF6B6B;cursor:pointer;font-size:11px;font-family:'DM Sans',sans-serif">🗑 Delete</button>
          </div>
          <div style="font-size:10px;color:var(--muted);line-height:1.9;margin-top:8px">
            <b>Click</b> to select<br><b>Drag</b> to move<br><b>Right-drag</b> orbit<br><b>Scroll</b> zoom
          </div>
        </div>
      </div>
      <!-- Canvas -->
      <div style="flex:1;position:relative;background:transparent">
        <canvas id="c3d-tfurn" style="width:100%;height:100%;display:block;min-height:520px"></canvas>
        <div style="position:absolute;bottom:10px;right:14px;font-size:10px;color:rgba(255,255,255,0.3)">Right-drag orbit · Scroll zoom</div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"></script>
<script src="../js/tms-data.js"></script>
<script src="../js/house3d.js"></script>
<script src="../js/furniture3d.js"></script>
<script>
// Build tenant furniture catalog
(function buildTFurnCatalog() {
  const catalog = [
    {type:'sofa',         label:'Sofa',         color:'#5D5A7E', icon:'🛋️'},
    {type:'armchair',     label:'Armchair',     color:'#7B4F3A', icon:'🪑'},
    {type:'bed_double',   label:'Double Bed',   color:'#7B4F2A', icon:'🛏️'},
    {type:'bed_single',   label:'Single Bed',   color:'#7A8B6E', icon:'🛏️'},
    {type:'dining_table', label:'Dining Table', color:'#A0734A', icon:'🍽️'},
    {type:'dining_chair', label:'Din. Chair',   color:'#A0734A', icon:'🪑'},
    {type:'chair',        label:'Chair',        color:'#8B6040', icon:'🪑'},
    {type:'wardrobe',     label:'Wardrobe',     color:'#9B7B5A', icon:'🚪'},
    {type:'tv_unit',      label:'TV Unit',      color:'#4A3A2A', icon:'📺'},
    {type:'bookshelf',    label:'Bookshelf',    color:'#8B6A3A', icon:'📚'},
    {type:'coffee_table', label:'Coffee Table', color:'#A08060', icon:'☕'},
    {type:'lamp',         label:'Floor Lamp',   color:'#C0A060', icon:'💡'},
    {type:'plant',        label:'Plant',        color:'#3A6A40', icon:'🪴'},
    {type:'mirror',       label:'Mirror',       color:'#C8A060', icon:'🪞'},
    {type:'desk',         label:'Desk',         color:'#9B7A4A', icon:'🖥️'},
  ];
  const container = document.getElementById('tfurn-catalog');
  if (!container) return;
  catalog.forEach(item => {
    const btn = document.createElement('button');
    btn.style.cssText = 'padding:7px 8px;border-radius:8px;border:1px solid var(--border);background:var(--card);color:var(--text);cursor:pointer;font-family:DM Sans,sans-serif;font-size:11.5px;text-align:left;display:flex;align-items:center;gap:7px;transition:background 0.12s';
    btn.innerHTML = `<span style="font-size:15px">${item.icon}</span><span>${item.label}</span>`;
    btn.onmouseenter = () => btn.style.background = 'var(--hover)';
    btn.onmouseleave = () => btn.style.background = 'var(--card)';
    btn.onclick = () => tFurnAddItem(item.type, item.color);
    container.appendChild(btn);
  });
})();

// ── Furniture Page (dedicated page) ──────────────────────────
const FURN_CATALOG = [
  {type:'sofa',         label:'Sofa',         color:'#5D5A7E', icon:'🛋️'},
  {type:'armchair',     label:'Armchair',     color:'#7B4F3A', icon:'🪑'},
  {type:'bed_double',   label:'Double Bed',   color:'#7B4F2A', icon:'🛏️'},
  {type:'bed_single',   label:'Single Bed',   color:'#7A8B6E', icon:'🛏️'},
  {type:'dining_table', label:'Dining Table', color:'#A0734A', icon:'🍽️'},
  {type:'dining_chair', label:'Din. Chair',   color:'#A0734A', icon:'🪑'},
  {type:'chair',        label:'Chair',        color:'#8B6040', icon:'🪑'},
  {type:'wardrobe',     label:'Wardrobe',     color:'#9B7B5A', icon:'🚪'},
  {type:'tv_unit',      label:'TV Unit',      color:'#4A3A2A', icon:'📺'},
  {type:'bookshelf',    label:'Bookshelf',    color:'#8B6A3A', icon:'📚'},
  {type:'coffee_table', label:'Coffee Table', color:'#A08060', icon:'☕'},
  {type:'lamp',         label:'Floor Lamp',   color:'#C0A060', icon:'💡'},
  {type:'plant',        label:'Plant',        color:'#3A6A40', icon:'🪴'},
  {type:'mirror',       label:'Mirror',       color:'#C8A060', icon:'🪞'},
  {type:'desk',         label:'Desk',         color:'#9B7A4A', icon:'🖥️'},
];

let _furnPagePropId = null;
let _furnPageShowingLandlord = false;

function loadFurniturePage() {
  // Populate property dropdown
  const sel = document.getElementById('furn-prop-select');
  if (!sel) return;
  const current = sel.value;
  sel.innerHTML = '<option value="">— Select a property —</option>';
  (allProps||[]).forEach(p => {
    const opt = document.createElement('option');
    opt.value = p._id;
    const isRented = p.status === 'rented';
    opt.textContent = (p.title || 'Property') + (isRented ? ' ✓ My Rental' : '');
    if (isRented) opt.style.color = '#C9A96E';
    sel.appendChild(opt);
  });
  // Auto-select rented property if none selected
  if (!sel.value) {
    const rented = (allProps||[]).find(p => p.status === 'rented');
    if (rented) { sel.value = rented._id; loadFurnForProp(rented._id); }
  }
  if (current) sel.value = current;

  // Build catalog buttons once
  const cat = document.getElementById('furn-page-catalog');
  if (cat && !cat.hasChildNodes()) {
    FURN_CATALOG.forEach(item => {
      const btn = document.createElement('button');
      btn.style.cssText = 'padding:6px 10px;border-radius:8px;border:1px solid var(--border);background:var(--card);color:var(--text);cursor:pointer;font-family:DM Sans,sans-serif;font-size:11.5px;display:flex;align-items:center;gap:5px;transition:background 0.12s';
      btn.innerHTML = `<span>${item.icon}</span><span>${item.label}</span>`;
      btn.onmouseenter = () => btn.style.background = 'var(--input-bg)';
      btn.onmouseleave = () => btn.style.background = 'var(--card)';
      btn.onclick = () => {
        const sc = getFurnitureScene('c3d-furnpage');
        if (sc) sc.addFurniture(item.type, parseInt(item.color.replace('#',''),16));
      };
      cat.appendChild(btn);
    });
  }

  // furn-page-controls is now directly managed by furniture3d.js via getActionPanelId()
  // No MutationObserver needed — c3d-furnpage maps to furn-page-controls directly
}

function loadFurnForProp(propId) {
  _furnPagePropId = propId;
  _furnPageShowingLandlord = false;
  const placeholder = document.getElementById('furn-page-placeholder');
  const main = document.getElementById('furn-page-main');
  const badge = document.getElementById('furn-page-saved-badge');
  const toggleBtn = document.getElementById('furn-page-toggle');
  const saveBtn = document.getElementById('furn-page-save-btn');
  const label = document.getElementById('furn-page-viewlabel');

  if (!propId) {
    if (placeholder) placeholder.style.display = 'flex';
    if (main) main.style.display = 'none';
    return;
  }

  const p = (window._tenantPropMap||{})[propId];
  if (!p) return;

  const tenantLayout   = p.tenantFurnitureLayout  || {};
  const landlordLayout = p.landlordFurnitureLayout || {};
  const hasTenant   = Object.keys(tenantLayout).length > 0;
  const hasLandlord = Object.keys(landlordLayout).length > 0;

  if (placeholder) placeholder.style.display = 'none';
  if (main) { main.style.display = 'flex'; }

  if (badge) { badge.style.display = hasTenant ? 'flex' : 'none'; }
  if (toggleBtn) {
    toggleBtn.style.display = hasLandlord ? 'inline-flex' : 'none';
    toggleBtn.textContent = '🏠 View Landlord Layout';
  }
  if (saveBtn) saveBtn.style.display = '';
  if (label) label.style.display = 'none';

  setTimeout(() => {
    if (typeof initFurniturePlacement === 'function') {
      window._furnPageScene = initFurniturePlacement('c3d-furnpage', tenantLayout, null);
    }
  }, 100);
}

function furnPageToggleView() {
  const propId = _furnPagePropId;
  if (!propId) return;
  const p = (window._tenantPropMap||{})[propId];
  if (!p) return;

  _furnPageShowingLandlord = !_furnPageShowingLandlord;
  const isLandlord = _furnPageShowingLandlord;
  const layout = isLandlord ? (p.landlordFurnitureLayout||{}) : (p.tenantFurnitureLayout||{});

  const toggleBtn = document.getElementById('furn-page-toggle');
  const saveBtn   = document.getElementById('furn-page-save-btn');
  const label     = document.getElementById('furn-page-viewlabel');
  const badge     = document.getElementById('furn-page-saved-badge');

  if (toggleBtn) toggleBtn.textContent = isLandlord ? '🛋️ Back to My Layout' : '🏠 View Landlord Layout';
  if (saveBtn)   saveBtn.style.display = isLandlord ? 'none' : '';
  if (label)     { label.style.display = isLandlord ? 'block' : 'none'; label.textContent = '🏠 Landlord Layout (View Only)'; }
  if (badge)     {
    const hasTenant = Object.keys(p.tenantFurnitureLayout||{}).length > 0;
    badge.style.display = isLandlord ? 'none' : (hasTenant ? 'flex' : 'none');
  }

  setTimeout(() => {
    if (typeof initFurniturePlacement === 'function') {
      window._furnPageScene = initFurniturePlacement('c3d-furnpage', layout, null);
    }
  }, 80);
}

async function furnPageSave() {
  if (_furnPageShowingLandlord) { alert('Landlord layout sirf view mode mein hai.'); return; }
  const sc = window._furnPageScene;
  if (!sc || !_furnPagePropId) return;
  const layout = sc.getLayout();
  const btn = document.getElementById('furn-page-save-btn');
  if (btn) { btn.disabled=true; btn.textContent='Saving…'; }
  try {
    await tFetch('/properties/'+_furnPagePropId+'/furniture/tenant','PUT',layout);
    const badge = document.getElementById('furn-page-saved-badge');
    if (badge) badge.style.display = 'flex';
    // Refresh allProps map
    const data = await tFetch('/properties?status=available');
    allProps = data.properties||[];
    window._tenantPropMap = {};
    allProps.forEach(p => { window._tenantPropMap[p._id] = p; });
    // Check if landlord has layout now — show toggle
    const updatedProp = (window._tenantPropMap||{})[_furnPagePropId];
    const hasLandlord = Object.keys((updatedProp||{}).landlordFurnitureLayout||{}).length > 0;
    const toggleBtn = document.getElementById('furn-page-toggle');
    if (toggleBtn) toggleBtn.style.display = hasLandlord ? 'inline-flex' : 'none';
    // Flash success
    if (btn) { btn.textContent='✅ Saved!'; setTimeout(()=>btn.textContent='💾 Save My Layout',2000); }
  } catch(e) { alert('Save nahi hua. Backend check karein.'); }
  finally { if(btn) btn.disabled=false; }
}

function furnPageRotate(deg) { const sc=window._furnPageScene; if(sc) sc.rotateSelected(deg); }
function furnPageDelete()    { const sc=window._furnPageScene; if(sc) sc.deleteSelected(); }
function furnPageDownloadPNG()  {
  const p = (window._tenantPropMap||{})[_furnPagePropId];
  if(typeof downloadFurnitureScreenshot==='function') downloadFurnitureScreenshot('c3d-furnpage', (p?.title||'property')+'-my-layout');
}
function furnPageDownloadJSON() {
  const p = (window._tenantPropMap||{})[_furnPagePropId];
  if(typeof downloadFurnitureJSON==='function') downloadFurnitureJSON('c3d-furnpage', p?.title||'property', 'tenant');
}
</script>

<!-- ══════════════════════════════════════════════════════
     DIGITAL SIGNATURE PAD MODAL
══════════════════════════════════════════════════════ -->
<div id="sig-pad-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:9999;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(6px)">
  <div style="background:var(--card);border:1px solid rgba(201,169,110,0.15);border-radius:22px;width:min(560px,97vw);max-height:90vh;overflow-y:auto">
    <div style="display:flex;align-items:center;justify-content:space-between;padding:20px 24px;border-bottom:1px solid rgba(201,169,110,0.1)">
      <div>
        <div style="font-family:'Cormorant Garamond','Playfair Display',serif;font-size:20px;font-weight:700;color:var(--text)">Digital Signature</div>
        <div style="font-size:11px;color:var(--muted);margin-top:2px;letter-spacing:0.4px">Recognized under Electronic Transactions Ordinance 2002, Pakistan</div>
      </div>
      <button onclick="closeSignaturePad()" style="width:32px;height:32px;border-radius:50%;border:none;background:rgba(255,107,107,0.12);color:#FF6B6B;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center">✕</button>
    </div>
    <div style="padding:22px 24px">
      <!-- Tabs -->
      <div style="display:flex;background:rgba(255,255,255,0.04);border-radius:10px;padding:3px;margin-bottom:18px;gap:3px">
        <button id="sig-tab-draw" onclick="switchSigTab('draw')" style="flex:1;padding:9px;border-radius:8px;border:none;background:rgba(201,169,110,0.15);color:var(--gold);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;cursor:pointer">✍️ Draw Signature</button>
        <button id="sig-tab-type" onclick="switchSigTab('type')" style="flex:1;padding:9px;border-radius:8px;border:none;background:transparent;color:var(--muted);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;cursor:pointer">⌨️ Type Signature</button>
        <button id="sig-tab-thumb" onclick="switchSigTab('thumb')" style="flex:1;padding:9px;border-radius:8px;border:none;background:transparent;color:var(--muted);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;cursor:pointer">👆 Thumb Print</button>
      </div>

      <!-- DRAW TAB -->
      <div id="sig-panel-draw">
        <div style="font-size:12px;color:var(--muted);margin-bottom:8px">Draw your signature using mouse or touch:</div>
        <canvas id="sig-canvas" width="510" height="160" style="width:100%;height:160px;background:rgba(255,255,255,0.04);border:2px dashed rgba(201,169,110,0.25);border-radius:12px;cursor:crosshair;touch-action:none"></canvas>
        <div style="display:flex;gap:8px;margin-top:10px">
          <button onclick="clearSigCanvas()" style="padding:7px 16px;border-radius:8px;border:1px solid var(--border);background:var(--input-bg);color:var(--muted);font-family:'DM Sans',sans-serif;font-size:12px;cursor:pointer">🗑️ Clear</button>
          <div style="margin-left:auto;display:flex;gap:6px;align-items:center">
            <label style="font-size:11px;color:var(--muted)">Color:</label>
            <input type="color" id="sig-color" value="#1a1a2e" style="width:28px;height:28px;border-radius:6px;border:1px solid var(--border);cursor:pointer;padding:1px">
          </div>
        </div>
      </div>

      <!-- TYPE TAB -->
      <div id="sig-panel-type" style="display:none">
        <div style="font-size:12px;color:var(--muted);margin-bottom:8px">Type your full name — it will be rendered as a signature:</div>
        <input id="sig-typed-name" oninput="renderTypedSig()" placeholder="Your full name..." style="width:100%;background:var(--input-bg);border:1.5px solid rgba(201,169,110,0.2);border-radius:10px;padding:11px 14px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;outline:none;margin-bottom:12px">
        <canvas id="sig-type-canvas" width="510" height="100" style="width:100%;height:100px;background:rgba(255,255,255,0.04);border:1px solid rgba(201,169,110,0.15);border-radius:10px"></canvas>
        <div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap">
          ${['Dancing Script','Pacifico','Great Vibes','Satisfy'].map((f,i)=>`<button onclick="setSigFont('${f}')" style="padding:5px 12px;border-radius:6px;border:1px solid var(--border);background:var(--input-bg);color:var(--muted);font-family:'${f}',cursive;font-size:13px;cursor:pointer">${f}</button>`).join('')}
        </div>
      </div>

      <!-- THUMB TAB -->
      <div id="sig-panel-thumb" style="display:none;text-align:center;padding:20px 0">
        <div style="font-size:48px;margin-bottom:12px">👆</div>
        <div style="font-size:15px;font-weight:700;color:var(--text);margin-bottom:6px">Fingerprint / Thumb Impression</div>
        <div style="font-size:12px;color:var(--muted);line-height:1.7;max-width:360px;margin:0 auto">
          For thumb impression, please physically press your inked thumb onto a paper and scan/photograph it. You can upload the image below, or use it on the printed document.
        </div>
        <div style="margin-top:16px">
          <input type="file" id="thumb-upload" accept="image/*" onchange="loadThumbImage(event)" style="display:none">
          <button onclick="document.getElementById('thumb-upload').click()" style="padding:10px 24px;border-radius:10px;border:1.5px dashed rgba(201,169,110,0.3);background:rgba(201,169,110,0.06);color:var(--gold);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;cursor:pointer">📷 Upload Thumb Image</button>
        </div>
        <canvas id="sig-thumb-canvas" width="200" height="200" style="margin-top:14px;border-radius:50%;background:rgba(255,255,255,0.04);border:2px dashed rgba(201,169,110,0.2);display:none;max-width:160px;max-height:160px"></canvas>
        <!-- Simulated fingerprint -->
        <div id="thumb-sim" style="margin-top:16px;width:120px;height:120px;border-radius:50%;background:rgba(201,169,110,0.06);border:2px dashed rgba(201,169,110,0.2);display:flex;align-items:center;justify-content:center;margin-left:auto;margin-right:auto">
          <svg width="70" height="90" viewBox="0 0 70 90" style="opacity:0.4">
            <path d="M35 5 C20 5 8 17 8 32 C8 50 20 65 35 78 C50 65 62 50 62 32 C62 17 50 5 35 5Z" fill="none" stroke="#C9A96E" stroke-width="1.5"/>
            <path d="M35 12 C24 12 15 21 15 32 C15 47 24 60 35 72 C46 60 55 47 55 32 C55 21 46 12 35 12Z" fill="none" stroke="#C9A96E" stroke-width="1.5"/>
            <path d="M35 20 C28 20 22 26 22 33 C22 44 28 55 35 65 C42 55 48 44 48 33 C48 26 42 20 35 20Z" fill="none" stroke="#C9A96E" stroke-width="1.5"/>
            <path d="M35 28 C31 28 28 31 28 35 C28 42 31 50 35 57 C39 50 42 42 42 35 C42 31 39 28 35 28Z" fill="none" stroke="#C9A96E" stroke-width="1.5"/>
            <circle cx="35" cy="35" r="4" fill="rgba(201,169,110,0.3)"/>
          </svg>
        </div>
        <div style="font-size:11px;color:var(--muted);margin-top:10px">Fingerprint — For Legal Enforceability, Use Physical Stamp on Printed Copy</div>
      </div>

      <!-- Confirmation -->
      <div style="margin-top:18px;background:rgba(201,169,110,0.05);border:1px solid rgba(201,169,110,0.12);border-radius:10px;padding:12px 14px">
        <label style="display:flex;align-items:flex-start;gap:10px;cursor:pointer">
          <input type="checkbox" id="sig-confirm" style="margin-top:2px;width:15px;height:15px;accent-color:var(--gold);flex-shrink:0">
          <span style="font-size:12px;color:var(--muted);line-height:1.6">I confirm that I have read and understood the Tenancy Agreement and agree to all terms and conditions. I understand this digital signature is legally binding under the Electronic Transactions Ordinance 2002 of Pakistan.</span>
        </label>
      </div>
      <div style="display:flex;gap:10px;margin-top:14px">
        <button onclick="applyDigitalSignature()" style="flex:1;padding:12px;border-radius:10px;border:none;background:linear-gradient(135deg,var(--gold),var(--gold-l,#E8C97A));color:#0A0C0F;font-family:'DM Sans',sans-serif;font-size:14px;font-weight:700;cursor:pointer;letter-spacing:0.1px">✅ Apply Signature to Agreement</button>
      </div>
      <div id="sig-error" style="display:none;margin-top:10px;padding:9px 13px;background:rgba(255,107,107,0.1);border:1px solid rgba(255,107,107,0.2);border-radius:8px;color:#FF6B6B;font-size:12px;font-weight:600"></div>
    </div>
  </div>
</div>

<!-- FULL AGREEMENT DOCUMENT MODAL -->
<div id="lease-doc-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:9999;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(6px)">
  <div style="background:var(--card);border:1px solid rgba(201,169,110,0.15);border-radius:22px;width:min(800px,97vw);max-height:92vh;display:flex;flex-direction:column">
    <div style="display:flex;align-items:center;justify-content:space-between;padding:18px 24px;border-bottom:1px solid rgba(201,169,110,0.1)">
      <div style="font-family:'Cormorant Garamond','Playfair Display',serif;font-size:18px;font-weight:700;color:var(--text)">Full Tenancy Agreement</div>
      <div style="display:flex;gap:8px">
        <button onclick="printLeaseAgreement()" style="padding:7px 14px;border-radius:8px;border:1px solid rgba(201,169,110,0.2);background:rgba(201,169,110,0.08);color:var(--gold);font-family:'DM Sans',sans-serif;font-size:12px;font-weight:600;cursor:pointer">🖨️ Print</button>
        <button onclick="closeLeaseDocModal()" style="width:32px;height:32px;border-radius:50%;border:none;background:rgba(255,107,107,0.12);color:#FF6B6B;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center">✕</button>
      </div>
    </div>
    <div id="lease-doc-body" style="flex:1;overflow-y:auto;padding:30px 36px;font-family:'DM Sans',sans-serif;line-height:1.8;color:var(--text)"></div>
  </div>
</div>

<!-- PRINT STYLES -->
<style id="print-style">
@media print {
  body * { visibility: hidden !important; }
  #print-lease-area, #print-lease-area * { visibility: visible !important; }
  #print-lease-area {
    position: absolute !important; left: 0 !important; top: 0 !important;
    width: 100% !important; background: white !important; color: black !important;
    font-family: 'Times New Roman', serif !important;
  }
}
</style>

<!-- HIDDEN PRINT AREA -->
<div id="print-lease-area" style="display:none"></div>

<!-- SIGNATURE SCRIPTS -->
<script>
// ══════════════════════════════════════════════════════════
//  DIGITAL SIGNATURE PAD — TENANT
// ══════════════════════════════════════════════════════════
let _sigLeaseId = null;
let _sigDrawing = false;
let _sigFont = 'Dancing Script';
let _sigTab = 'draw';
let _thumbImageData = null;

// Load signature fonts
const sigFontLink = document.createElement('link');
sigFontLink.rel = 'stylesheet';
sigFontLink.href = 'https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Pacifico&family=Great+Vibes&family=Satisfy&display=swap';
document.head.appendChild(sigFontLink);

function openSignaturePad(leaseId) {
  _sigLeaseId = leaseId;
  clearSigCanvas();
  document.getElementById('sig-confirm').checked = false;
  document.getElementById('sig-error').style.display = 'none';
  const modal = document.getElementById('sig-pad-modal');
  modal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
  setTimeout(initSigCanvas, 100);
}

function closeSignaturePad() {
  document.getElementById('sig-pad-modal').style.display = 'none';
  document.body.style.overflow = '';
}

function switchSigTab(tab) {
  _sigTab = tab;
  ['draw','type','thumb'].forEach(t => {
    document.getElementById('sig-panel-'+t).style.display = t===tab ? 'block' : 'none';
    const btn = document.getElementById('sig-tab-'+t);
    if(btn) {
      btn.style.background = t===tab ? 'rgba(201,169,110,0.15)' : 'transparent';
      btn.style.color = t===tab ? 'var(--gold)' : 'var(--muted)';
      btn.style.fontWeight = t===tab ? '600' : '500';
    }
  });
}

// ── Canvas Signature ──
function initSigCanvas() {
  const canvas = document.getElementById('sig-canvas');
  if(!canvas) return;
  const ctx = canvas.getContext('2d');
  ctx.strokeStyle = document.getElementById('sig-color')?.value || '#1a1a2e';
  ctx.lineWidth = 2.5;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';

  let lastX, lastY;

  function getPos(e) {
    const r = canvas.getBoundingClientRect();
    const scaleX = canvas.width / r.width;
    const scaleY = canvas.height / r.height;
    if(e.touches) {
      return [(e.touches[0].clientX - r.left)*scaleX, (e.touches[0].clientY - r.top)*scaleY];
    }
    return [(e.clientX - r.left)*scaleX, (e.clientY - r.top)*scaleY];
  }

  canvas.onmousedown = canvas.ontouchstart = (e) => {
    e.preventDefault();
    _sigDrawing = true;
    [lastX, lastY] = getPos(e);
    ctx.beginPath();
    ctx.moveTo(lastX, lastY);
  };
  canvas.onmousemove = canvas.ontouchmove = (e) => {
    e.preventDefault();
    if(!_sigDrawing) return;
    ctx.strokeStyle = document.getElementById('sig-color')?.value || '#1a1a2e';
    const [x, y] = getPos(e);
    ctx.lineTo(x, y);
    ctx.stroke();
    [lastX, lastY] = [x, y];
  };
  canvas.onmouseup = canvas.ontouchend = () => { _sigDrawing = false; };
  canvas.onmouseleave = () => { _sigDrawing = false; };
}

function clearSigCanvas() {
  const canvas = document.getElementById('sig-canvas');
  if(!canvas) return;
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0, 0, canvas.width, canvas.height);
}

// ── Typed Signature ──
function renderTypedSig() {
  const name = document.getElementById('sig-typed-name')?.value || '';
  const canvas = document.getElementById('sig-type-canvas');
  if(!canvas) return;
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  if(!name) return;
  ctx.fillStyle = 'transparent';
  ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.font = \`52px '\${_sigFont}', cursive\`;
  ctx.fillStyle = '#1a3a6a';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(name, canvas.width/2, canvas.height/2);
}

function setSigFont(font) {
  _sigFont = font;
  renderTypedSig();
}

// ── Thumb Upload ──
function loadThumbImage(event) {
  const file = event.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = (e) => {
    const canvas = document.getElementById('sig-thumb-canvas');
    canvas.style.display = 'block';
    document.getElementById('thumb-sim').style.display = 'none';
    const img = new Image();
    img.onload = () => {
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0,0,canvas.width,canvas.height);
      const size = Math.min(img.width,img.height);
      ctx.drawImage(img, (img.width-size)/2, (img.height-size)/2, size, size, 0, 0, canvas.width, canvas.height);
      _thumbImageData = canvas.toDataURL('image/png');
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

// ── Apply Signature ──
async function applyDigitalSignature() {
  const errEl = document.getElementById('sig-error');
  errEl.style.display = 'none';

  if(!document.getElementById('sig-confirm')?.checked) {
    errEl.style.display = 'block';
    errEl.textContent = '⚠️ Please read and confirm the agreement terms before signing.';
    return;
  }

  let sigData = null;

  if(_sigTab === 'draw') {
    const canvas = document.getElementById('sig-canvas');
    const ctx = canvas.getContext('2d');
    const imageData = ctx.getImageData(0,0,canvas.width,canvas.height);
    const hasData = imageData.data.some((v,i) => i%4!==3 && v>0);
    if(!hasData) { errEl.style.display='block'; errEl.textContent='⚠️ Please draw your signature.'; return; }
    sigData = canvas.toDataURL('image/png');
  } else if(_sigTab === 'type') {
    const name = document.getElementById('sig-typed-name')?.value?.trim();
    if(!name) { errEl.style.display='block'; errEl.textContent='⚠️ Please type your name.'; return; }
    renderTypedSig();
    sigData = document.getElementById('sig-type-canvas').toDataURL('image/png');
  } else if(_sigTab === 'thumb') {
    if(!_thumbImageData) {
      // Generate fingerprint simulation mark
      const canvas = document.createElement('canvas');
      canvas.width = 150; canvas.height = 150;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = 'rgba(201,169,110,0.15)';
      ctx.beginPath(); ctx.arc(75,75,65,0,Math.PI*2); ctx.fill();
      ctx.strokeStyle = 'rgba(201,169,110,0.5)'; ctx.lineWidth = 1.5;
      for(let i=0;i<6;i++){
        ctx.beginPath();
        ctx.arc(75,75, 15+(i*9), 0, Math.PI*2);
        ctx.stroke();
      }
      ctx.font = 'bold 10px DM Sans'; ctx.fillStyle='rgba(201,169,110,0.7)';
      ctx.textAlign='center'; ctx.fillText('THUMB', 75, 140);
      sigData = canvas.toDataURL('image/png');
    } else {
      sigData = _thumbImageData;
    }
  }

  // Save signature to backend
  if(!_sigLeaseId) { errEl.style.display='block'; errEl.textContent='⚠️ No lease found.'; return; }
  try {
    const user = JSON.parse(localStorage.getItem('tms_user')||'{}');
    const tok = () => localStorage.getItem('tms_token') || sessionStorage.getItem('tms_token') || '';
    const r = await fetch('http://localhost:5000/api/leases/' + _sigLeaseId, {
      method: 'PUT',
      headers: { 'Content-Type':'application/json', 'Authorization':'Bearer '+tok() },
      body: JSON.stringify({
        tenantSignature: sigData,
        signedAt: new Date().toISOString(),
        signatureMethod: _sigTab
      })
    });
    const data = await r.json();
    if(data.success) {
      closeSignaturePad();
      await loadLease();
      // Show success toast
      const toast = document.createElement('div');
      toast.innerHTML = '✅ Agreement digitally signed successfully!';
      toast.style.cssText = 'position:fixed;bottom:24px;right:24px;background:rgba(34,197,94,0.15);border:1px solid rgba(34,197,94,0.3);color:#22c55e;padding:12px 20px;border-radius:12px;font-weight:700;font-size:13px;z-index:99999;animation:fadeIn 0.3s ease';
      document.body.appendChild(toast);
      setTimeout(()=>toast.remove(), 4000);
    } else {
      errEl.style.display='block';
      errEl.textContent = '⚠️ ' + (data.message || 'Could not save signature. Please try again.');
    }
  } catch(e) {
    errEl.style.display='block';
    errEl.textContent = '⚠️ Cannot connect to server.';
  }
}

// ── Full Document Modal ──
function openLeaseDocumentModal() {
  const l = window._currentLease;
  if(!l) return;
  const user = JSON.parse(localStorage.getItem('tms_user')||'{}');
  const signedDate = new Date(l.signedAt||l.createdAt).toLocaleDateString('en-PK',{day:'numeric',month:'long',year:'numeric'});
  const terms = (l.terms || getStandardLeaseTerms()).replace(/
/g,'<br>').replace(/ARTICLE /g,'<strong>ARTICLE ').replace(/—/g,'</strong> —');

  document.getElementById('lease-doc-body').innerHTML = \`
    <div style="max-width:680px;margin:0 auto;color:var(--text)">
      <!-- Official Header -->
      <div style="text-align:center;border-bottom:3px double rgba(201,169,110,0.3);padding-bottom:24px;margin-bottom:28px">
        <div style="font-size:11px;text-transform:uppercase;letter-spacing:2px;color:var(--muted);font-weight:700;margin-bottom:8px">Islamic Republic of Pakistan</div>
        <div style="font-family:'Cormorant Garamond','Playfair Display',serif;font-size:32px;font-weight:700;color:var(--text);margin-bottom:4px">Tenancy Agreement</div>
        <div style="font-size:12px;color:var(--muted)">In Accordance With Punjab Rented Premises Act 2009 (Act XIX of 2009)</div>
        <div style="margin-top:10px;font-size:11px;color:var(--muted)">Executed on: <strong>\${signedDate}</strong></div>
      </div>

      <!-- Parties -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:28px">
        <div style="border:1px solid rgba(201,169,110,0.15);border-radius:10px;padding:16px">
          <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:var(--muted);margin-bottom:8px">FIRST PARTY (Lessor / Landlord)</div>
          <div style="font-size:16px;font-weight:700;color:var(--text);margin-bottom:4px">\${l.landlordName||'—'}</div>
          <div style="font-size:12px;color:var(--muted)">Owner of the rented premises</div>
        </div>
        <div style="border:1px solid rgba(74,158,255,0.2);border-radius:10px;padding:16px">
          <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:var(--muted);margin-bottom:8px">SECOND PARTY (Lessee / Tenant)</div>
          <div style="font-size:16px;font-weight:700;color:var(--text);margin-bottom:4px">\${l.tenantName||user.name||'—'}</div>
          <div style="font-size:12px;color:var(--muted)">Resident occupant of the premises</div>
        </div>
      </div>

      <!-- Property Details -->
      <div style="border:1px solid rgba(201,169,110,0.12);border-radius:10px;padding:16px;margin-bottom:28px">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:var(--muted);margin-bottom:12px">PROPERTY DETAILS</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:13px">
          <div><span style="color:var(--muted)">Title:</span> <strong>\${l.propertyTitle||'—'}</strong></div>
          <div><span style="color:var(--muted)">Address:</span> <strong>\${l.propertyAddress||'—'}</strong></div>
          <div><span style="color:var(--muted)">Monthly Rent:</span> <strong style="color:var(--blue)">Rs. \${Number(l.rent||0).toLocaleString()}</strong></div>
          <div><span style="color:var(--muted)">Duration:</span> <strong>\${l.duration||'11 months'}</strong></div>
          <div><span style="color:var(--muted)">Commencement:</span> <strong>\${l.startDate||'—'}</strong></div>
          <div><span style="color:var(--muted)">Expiry:</span> <strong>\${l.endDate||'—'}</strong></div>
        </div>
      </div>

      <!-- Terms -->
      <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:var(--muted);margin-bottom:14px">TERMS & CONDITIONS</div>
      <div style="font-size:13px;line-height:2;color:var(--text);border-left:3px solid rgba(201,169,110,0.2);padding-left:16px;margin-bottom:32px">\${terms}</div>

      <!-- Signatures -->
      <div style="border-top:2px solid rgba(201,169,110,0.2);padding-top:24px;margin-top:24px">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:var(--muted);margin-bottom:16px">EXECUTION & SIGNATURES</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px">
          <div style="text-align:center;border:1px dashed rgba(201,169,110,0.25);border-radius:10px;padding:16px">
            <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--muted);margin-bottom:10px">Landlord Signature / Thumb</div>
            \${l.landlordSignature ? \`<img src="\${l.landlordSignature}" style="max-width:150px;max-height:60px;object-fit:contain;margin-bottom:8px">\` : \`<div style="height:60px;border-bottom:1px solid rgba(255,255,255,0.1);margin-bottom:8px"></div>\`}
            <div style="font-size:12px;font-weight:600;color:var(--text)">\${l.landlordName||'Landlord'}</div>
            <div style="font-size:10px;color:var(--muted)">Date: __________</div>
          </div>
          <div style="text-align:center;border:1px dashed rgba(74,158,255,0.25);border-radius:10px;padding:16px">
            <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--muted);margin-bottom:10px">Tenant Signature / Thumb</div>
            \${l.tenantSignature ? \`<img src="\${l.tenantSignature}" style="max-width:150px;max-height:60px;object-fit:contain;margin-bottom:8px">\` : \`<div style="height:60px;border-bottom:1px solid rgba(255,255,255,0.1);margin-bottom:8px"></div>\`}
            <div style="font-size:12px;font-weight:600;color:var(--text)">\${l.tenantName||user.name||'Tenant'}</div>
            <div style="font-size:10px;color:var(--muted)">Date: \${l.signedAt ? signedDate : '__________'}</div>
          </div>
        </div>
        <!-- Witnesses -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
          \${['Landlord\'s Witness','Tenant\'s Witness'].map(w=>\`
            <div style="border:1px dashed rgba(255,255,255,0.08);border-radius:10px;padding:14px;text-align:center">
              <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--muted);margin-bottom:8px">\${w}</div>
              <div style="height:50px;border-bottom:1px solid rgba(255,255,255,0.08);margin-bottom:8px"></div>
              <div style="font-size:11px;color:var(--muted)">Name: __________________</div>
              <div style="font-size:11px;color:var(--muted);margin-top:4px">CNIC: __________________</div>
            </div>
          \`).join('')}
        </div>
        \${l.tenantSignature ? \`<div style="margin-top:16px;padding:10px 14px;background:rgba(34,197,94,0.07);border:1px solid rgba(34,197,94,0.18);border-radius:8px;font-size:11px;color:#22c55e;text-align:center">🔐 Digitally Signed via TMS Platform | Electronic Transactions Ordinance 2002, Pakistan | Signed: \${signedDate}</div>\` : ''}
      </div>
    </div>
  \`;
  document.getElementById('lease-doc-modal').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function closeLeaseDocModal() {
  document.getElementById('lease-doc-modal').style.display = 'none';
  document.body.style.overflow = '';
}

function printLeaseAgreement() {
  const body = document.getElementById('lease-doc-body');
  if(!body?.innerHTML) { openLeaseDocumentModal(); setTimeout(printLeaseAgreement, 400); return; }
  const printArea = document.getElementById('print-lease-area');
  const l = window._currentLease || {};
  const user = JSON.parse(localStorage.getItem('tms_user')||'{}');
  const signedDate = new Date(l.signedAt||l.createdAt||Date.now()).toLocaleDateString('en-PK',{day:'numeric',month:'long',year:'numeric'});
  const terms = (l.terms || getStandardLeaseTerms());

  printArea.style.display = 'block';
  printArea.innerHTML = \`
    <div style="font-family:'Times New Roman',serif;color:#000;padding:40px;max-width:800px;margin:0 auto">
      <div style="text-align:center;border-bottom:2px double #000;padding-bottom:20px;margin-bottom:24px">
        <p style="font-size:11px;letter-spacing:2px;text-transform:uppercase;margin-bottom:6px">Islamic Republic of Pakistan</p>
        <h1 style="font-size:26px;font-weight:700;margin:0 0 4px">TENANCY AGREEMENT</h1>
        <p style="font-size:11px;color:#555">Punjab Rented Premises Act 2009 (Act XIX of 2009)</p>
        <p style="font-size:11px;margin-top:8px">Executed on: <strong>\${signedDate}</strong></p>
      </div>
      <table style="width:100%;border-collapse:collapse;margin-bottom:20px">
        <tr>
          <td style="border:1px solid #ccc;padding:12px;width:50%"><strong>Landlord:</strong> \${l.landlordName||'—'}</td>
          <td style="border:1px solid #ccc;padding:12px;width:50%"><strong>Tenant:</strong> \${l.tenantName||user.name||'—'}</td>
        </tr>
        <tr>
          <td style="border:1px solid #ccc;padding:12px"><strong>Property:</strong> \${l.propertyTitle||'—'}</td>
          <td style="border:1px solid #ccc;padding:12px"><strong>Address:</strong> \${l.propertyAddress||'—'}</td>
        </tr>
        <tr>
          <td style="border:1px solid #ccc;padding:12px"><strong>Monthly Rent:</strong> Rs. \${Number(l.rent||0).toLocaleString()}</td>
          <td style="border:1px solid #ccc;padding:12px"><strong>Duration:</strong> \${l.duration||'11 months'}</td>
        </tr>
        <tr>
          <td style="border:1px solid #ccc;padding:12px"><strong>Start Date:</strong> \${l.startDate||'—'}</td>
          <td style="border:1px solid #ccc;padding:12px"><strong>End Date:</strong> \${l.endDate||'—'}</td>
        </tr>
      </table>
      <h3 style="font-size:13px;text-transform:uppercase;letter-spacing:1px;border-bottom:1px solid #ccc;padding-bottom:6px;margin-bottom:14px">TERMS & CONDITIONS</h3>
      <div style="font-size:12px;line-height:1.9;white-space:pre-wrap">\${terms}</div>
      <div style="margin-top:40px;border-top:2px solid #000;padding-top:20px">
        <h3 style="font-size:12px;text-transform:uppercase;letter-spacing:1px;margin-bottom:20px">SIGNATURES & WITNESSES</h3>
        <table style="width:100%;border-collapse:collapse">
          <tr>
            <td style="width:50%;padding:12px;vertical-align:top">
              <p style="font-size:11px;font-weight:bold;text-transform:uppercase;margin-bottom:50px">Landlord Signature / Thumb:</p>
              <div style="border-bottom:1px solid #000;margin-bottom:6px"></div>
              <p style="font-size:11px">\${l.landlordName||'Landlord'}</p>
              <p style="font-size:10px;color:#555">Date: __________________</p>
            </td>
            <td style="width:50%;padding:12px;vertical-align:top">
              <p style="font-size:11px;font-weight:bold;text-transform:uppercase;margin-bottom:50px">Tenant Signature / Thumb:</p>
              <div style="border-bottom:1px solid #000;margin-bottom:6px"></div>
              <p style="font-size:11px">\${l.tenantName||user.name||'Tenant'}</p>
              <p style="font-size:10px;color:#555">Date: __________________</p>
            </td>
          </tr>
          <tr>
            <td style="padding:12px;vertical-align:top">
              <p style="font-size:11px;font-weight:bold;text-transform:uppercase;margin-bottom:50px">Landlord's Witness:</p>
              <div style="border-bottom:1px solid #000;margin-bottom:6px"></div>
              <p style="font-size:10px;color:#555">Name: __________________<br>CNIC: __________________</p>
            </td>
            <td style="padding:12px;vertical-align:top">
              <p style="font-size:11px;font-weight:bold;text-transform:uppercase;margin-bottom:50px">Tenant's Witness:</p>
              <div style="border-bottom:1px solid #000;margin-bottom:6px"></div>
              <p style="font-size:10px;color:#555">Name: __________________<br>CNIC: __________________</p>
            </td>
          </tr>
        </table>
      </div>
    </div>
  \`;

  window.print();
  setTimeout(() => { printArea.style.display = 'none'; printArea.innerHTML = ''; }, 1500);
}

// Close modals on backdrop
document.getElementById('sig-pad-modal').addEventListener('click', function(e){ if(e.target===this) closeSignaturePad(); });
document.getElementById('lease-doc-modal').addEventListener('click', function(e){ if(e.target===this) closeLeaseDocModal(); });

// Init first tab
setTimeout(()=>{ if(document.getElementById('sig-canvas')) initSigCanvas(); }, 200);
</script>
</body>

</html>
