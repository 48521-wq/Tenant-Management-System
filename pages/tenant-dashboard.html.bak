    // First try to get from selected property
    if (propId && window._tenantPropMap) {
      const selectedProp = window._tenantPropMap[propId];
      if (selectedProp) {
        landlordId = selectedProp.landlordId || '';
        landlordName = selectedProp.landlordName || '';
