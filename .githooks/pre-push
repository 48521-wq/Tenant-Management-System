#!/bin/sh
# Prevent accidental pushes to the protected branch `main`.
# To allow pushing to main temporarily, set environment variable: GIT_ALLOW_PUSH_MAIN=1
protected_branch="main"

while read local_ref local_sha remote_ref remote_sha
do
  if [ "$remote_ref" = "refs/heads/$protected_branch" ]; then
    if [ -z "$GIT_ALLOW_PUSH_MAIN" ]; then
      echo "ERROR: Pushing to '$protected_branch' is blocked by repository hook."
      echo "If you really want to push, run: GIT_ALLOW_PUSH_MAIN=1 git push origin $protected_branch"
      exit 1
    fi
  fi
done

exit 0
